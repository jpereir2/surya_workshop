\u001b[39;00m\\n\\u001b[1;32m    218\\u001b[0m \\n\\u001b[0;32m   (...)\\u001b[0m\\n\\u001b[1;32m    237\\u001b[0m \\u001b[38;5;124;03m    - No value is returned (Lightning uses logs for validation tracking).\\u001b[39;00m\\n\\u001b[1;32m    238\\u001b[0m \\u001b[38;5;124;03m    \\\"\\\"\\\"\\u001b[39;00m\\n\\u001b[0;32m--> 239\\u001b[0m     target \\u001b[38;5;241m=\\u001b[39m \\u001b[43mbatch\\u001b[49m\\u001b[43m[\\u001b[49m\\u001b[38;5;124;43m\\\"\\u001b[39;49m\\u001b[38;5;124;43mforecast\\u001b[39;49m\\u001b[38;5;124;43m\\\"\\u001b[39;49m\\u001b[43m]\\u001b[49m\\u001b[38;5;241m.\\u001b[39munsqueeze(\\u001b[38;5;241m1\\u001b[39m)\\u001b[38;5;241m.\\u001b[39mfloat()\\n\\u001b[1;32m    241\\u001b[0m     \\u001b[38;5;28;01mif\\u001b[39;00m \\u001b[38;5;28mself\\u001b[39m\\u001b[38;5;241m.\\u001b[39mpreprocess_fn \\u001b[38;5;129;01mis\\u001b[39;00m \\u001b[38;5;129;01mnot\\u001b[39;00m \\u001b[38;5;28;01mNone\\u001b[39;00m:\\n\\u001b[1;32m    242\\u001b[0m         batch \\u001b[38;5;241m=\\u001b[39m \\u001b[38;5;28mself\\u001b[39m\\u001b[38;5;241m.\\u001b[39mpreprocess_fn(batch)\\n\\n\\u001b[0;31mKeyError\\u001b[0m: 'forecast'\"}]}]}",
