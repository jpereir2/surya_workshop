            "raw_output": "150\t        Forward pass used by Lightning and by explicit calls in steps.\n151\t\n152\t        Parameters\n153\t        ----------\n154\t        batch:\n155\t            Batch dict (at minimum contains ``\"ts\"`` and ``\"forecast\"``).\n156\t\n157\t        Returns\n158\t        -------\n159\t        torch.Tensor\n160\t            Model predictions for the batch.\n161\t        \"\"\"\n162\t        return self.model(batch)\n163\t\n164\t    def training_step(self, batch: Dict[str, Any], batch_idx: int) -> torch.Tensor:\n165\t        \"\"\"\n166\t        Runs one training step on a single batch.\n167\t\n168\t        Workflow\n169\t        --------\n170\t        1) Extract inputs and targets from the batch:\n171\t              x = batch[\"ts\"]\n172\t              target = batch[\"forecast\"]\n173\t        2) Compute model output:\n174\t              output = self(x)\n175\t        3) Compute per-component losses and combine via provided weights:\n176\t              training_losses, training_loss_weights = training_loss(output, target)\n177\t        4) Log:\n178\t              - total weighted loss as \"train_loss\" (progress bar)\n179\t              - each component loss as \"train_loss_<name>\"\n180\t              - training metrics as \"train_metric_<name>\" (if any)\n181\t\n182\t        Notes\n183\t        -----\n184\t        - Targets are reshaped to shape [B, 1] by unsqueeze(1) to match a common\n185\t          \"single output per sample\" convention.\n186\t        - The loss combination depends on dict iteration order; ensure loss dict\n187\t          insertion order is consistent if that matters.\n188\t\n189\t        Returns\n190\t        -------\n191\t        torch.Tensor\n192\t            The scalar training loss used for backpropagation.\n193\t        \"\"\"\n194\t        target = batch[\"forecast\"].unsqueeze(1).float()\n195\t\n196\t        if self.preprocess_fn is not None:\n197\t            batch = self.preprocess_fn(batch)\n198\t        output = self(batch)\n199\t        training_losses, training_loss_weights = self.training_loss(output, target)\n200\t        loss = self._combine_losses(training_losses, training_loss_weights)\n201\t\n202\t        # Log aggregate loss and component losses.\n203\t        self.log(\"train_loss\", loss, prog_bar=True, batch_size=self.batch_size, sync_dist=True)\n204\t        for key in training_losses.keys():\n205\t            self.log(f\"train_loss_{key}\", training_losses[key], prog_bar=False, batch_size=self.batch_size, sync_dist=True)\n206\t\n207\t        # Log evaluation metrics (optional).\n208\t        training_evaluation_metrics, training_evaluation_weights = self.training_evaluation(output, target)\n209\t        if len(training_evaluation_weights) > 0:\n210\t            for key in training_evaluation_metrics.keys():\n211\t                self.log(f\"train_metric_{key}\", training_evaluation_metrics[key], prog_bar=False, batch_size=self.batch_size, sync_dist=True)\n212\t\n213\t        return loss\n214\t\n215\t    def validation_step(self, batch: Dict[str, Any], batch_idx: int) -> None:\n216\t        \"\"\"\n217\t        Runs one validation step on a single batch.\n218\t\n219\t        Workflow\n220\t        --------\n221\t        1) Extract inputs and targets\n222\t        2) Compute output\n223\t        3) Compute validation losses and combine via weights\n224\t        4) Log:\n225\t              - total weighted loss as \"val_loss\" (progress bar)\n226\t              - each component loss as \"val_loss_<name>\"\n227\t              - validation metrics as \"val_metric_<name>\" (if any)\n228\t\n229\t        Notes\n230\t        -----\n231\t        - The loss is computed with `self.validation_loss`, which comes from\n232\t          metrics[\"val_loss\"] and falls back to metrics[\"train_loss\"] when that key is\n233\t          absent. Supply a distinct \"val_loss\" callable to monitor something other than\n234\t          the training objective.\n235\t        - \"val_loss\" is what ModelCheckpoint monitors. The `val_metrics` logged at the end\n236\t          of this method are reported only and do not affect checkpoint selection.\n237\t        - No value is returned (Lightning uses logs for validation tracking).\n238\t        \"\"\"\n239\t        target = batch[\"forecast\"].unsqueeze(1).float()\n240\t\n241\t        if self.preprocess_fn is not None:\n242\t            batch = self.preprocess_fn(batch)\n243\t        output = self(batch)\n244\t        val_losses, val_loss_weights = self.validation_loss(output, target)\n245\t        loss = self._combine_losses(val_losses, val_loss_weights)\n246\t\n247\t        # Log aggregate loss and component losses.\n248\t        self.log(\"val_loss\", loss, prog_bar=True, batch_size=self.batch_size, sync_dist=True)\n249\t        for key in val_losses.keys():",
