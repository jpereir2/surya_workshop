del.to(\"cuda\").eval() from torch.utils.data._utils.collate import default_collate b = default_collate([s]) b = {k:(v.to(\"cuda\") if torch.is_tensor(v) else v) for k,v in b.items()} with torch.no_grad(), torch.autocast(\"cuda\", dtype=torch.bfloat16): pred = model(b).float() tgt = b[\"forecast\"][:,:,0].float() now = b[\"ts\"][:,:,-1].float() log(f\"pred {tuple(pred.shape)} target {tuple(tgt.shape)}\") rows=[] for i,c in enumerate(cfg.data.channels): inp = b[\"ts\"][0,i].float() rows.append(dict(channel=c, input_std=float(inp.std()), input_allzero=bool(torch.all(inp==0)), target_std=float(tgt[0,i].std()), mse=float(((pred[0,i]-tgt[0,i])**2).mean()), persistence=float(((now[0,i]-tgt[0,i])**2).mean()))) df = pd.DataFrame(rows) df[\"share_of_loss_%\"] = 100*df[\"mse\"]/df[\"mse\"].sum() pd.set_option(\"display.width\",200) print(df.to_string(index=False, float_format=lambda x: f\"{x:.4f}\")) print(f\"\\noverall MSE (all 13 flattened together) = {float(((pred-tgt)**2).mean()):.4f}\" f\" mean of per-channel = {df['mse'].mean():.4f} (equal -> every channel weighted alike)\") log(\"DONE\") PYEOF python t_channels.py 2>&1 | grep -v \"FutureWarning\\|warnings.warn\"",
