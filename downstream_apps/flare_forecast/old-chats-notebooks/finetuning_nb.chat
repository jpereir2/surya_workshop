              "command": "cd /home/jovyan/tmp/surya_workshop && grep -rn \"def fast_inverse_transform\" -A 25 workshop_infrastructure/ && echo \"=== helpers in nb0 ===\" && /home/jovyan/envs/surya_ws/bin/python -c \"\nimport json\nnb=json.load(open('downstream_apps/flare_forecast/0_dataset_TEST-2.ipynb'))\nfor i,c in enumerate(nb['cells']):\n    s=''.join(c['source'])\n    if '_lim' in s and 'def ' in s:\n        print(f'--- CELL {i} ---'); print(s)\n\""
