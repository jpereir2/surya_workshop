            "status": "completed",
            "raw_output": "1\tfrom __future__ import annotations\n2\t\n3\timport dataclasses\n4\tfrom typing import TYPE_CHECKING\n5\t\n6\timport torch\n7\t\n8\tif TYPE_CHECKING:\n9\t    from workshop_infrastructure.configs import ModelConfig\n10\tfrom torch import nn\n11\t\n12\tfrom workshop_infrastructure.models.helio_spectformer import HelioSpectFormer\n13\tfrom workshop_infrastructure.models.embedding import LinearDecoder, PerceiverDecoder\n14\t\n15\t\n16\t_VALID_POOLINGS = {\"global_average\", \"global_max\", \"attention\", \"transformer\", \"class_token\"}\n17\t\n18\t\n19\tclass ClassToken(nn.Module):\n20\t    \"\"\"A learnable CLS token, wrapped in a Module so PEFT can keep it trainable.\n21\t\n22\t    PEFT's ``modules_to_save`` accepts module *names* only, so a bare\n23\t    ``nn.Parameter`` on the top-level model would stay frozen in the LoRA\n24\t    regime.  Wrapping the token in a module lets the ``head_`` convention in\n25\t    ``apply_peft_lora()`` cover it like any other head component.\n26\t\n27\t    Always read the token by **calling** the module (``self.head_cls_token(B)``).\n28\t    Under PEFT the module is replaced by a wrapper that dispatches ``forward``\n29\t    to the trainable copy; reaching for the ``.token`` attribute instead\n30\t    delegates in version-dependent ways and can silently hand back the frozen\n31\t    original.\n32\t    \"\"\"\n33\t\n34\t    def __init__(self, embed_dim: int, init: str = \"zeros\"):\n35\t        super().__init__()\n36\t        if init == \"zeros\":\n37\t            data = torch.zeros(1, 1, embed_dim)\n38\t        elif init == \"randn\":\n39\t            data = torch.randn(1, 1, embed_dim)\n40\t        else:\n41\t            raise ValueError(f\"init must be 'zeros' or 'randn', got {init!r}\")\n42\t        self.token = nn.Parameter(data)\n43\t\n44\t    def forward(self, batch_size: int = 1) -> torch.Tensor:\n45\t        \"\"\"Return the token expanded to ``batch_size``, shape (batch_size, 1, embed_dim).\n46\t\n47\t        The argument is required: PEFT's wrapper forwards at least one\n48\t        positional argument, so a zero-argument ``forward()`` would raise.\n49\t        \"\"\"\n50\t        return self.token.expand(batch_size, -1, -1)\n51\t\n52\t\n53\tclass HelioSpectformer1D(nn.Module):\n54\t    \"\"\"\n55\t    Fine-tuning wrapper for 1D outputs (e.g. regression or classification).\n56\t\n57\t    Holds a frozen-or-trainable HelioSpectFormer backbone and adds a pooling\n58\t    layer plus a linear head on top. Only the head-specific parameters are\n59\t    defined here; all backbone parameters are forwarded to HelioSpectFormer.\n60\t\n61\t    Every trainable head component is a direct child whose name starts with\n62\t    ``head_``.  ``apply_peft_lora()`` discovers them by that prefix and keeps\n63\t    them trainable via ``modules_to_save``; see its docstring before adding a\n64\t    new head layer.\n65\t    \"\"\"\n66\t\n67\t    def __init__(\n68\t        self,\n69\t        # --- Backbone ---\n70\t        img_size: int,\n71\t        patch_size: int,\n72\t        in_chans: int,\n73\t        embed_dim: int,\n74\t        time_embedding: dict,\n75\t        depth: int,\n76\t        n_spectral_blocks: int,\n77\t        num_heads: int,\n78\t        mlp_ratio: float,\n79\t        drop_rate: float,\n80\t        window_size: int,\n81\t        dp_rank: int,\n82\t        learned_flow: bool = False,\n83\t        use_latitude_in_learned_flow: bool = False,\n84\t        init_weights: bool = False,\n85\t        checkpoint_layers: list[int] | None = None,\n86\t        rpe: bool = False,\n87\t        ensemble: int | None = None,\n88\t        dtype: torch.dtype = torch.bfloat16,\n89\t        # --- Fine-tuning head ---\n90\t        dropout: float = 0.1,\n91\t        num_outputs: int = 1,\n92\t        num_penultimate_transformer_layers: int = 1,\n93\t        num_penultimate_heads: int = 8,\n94\t        pooling: str = \"class_token\",\n95\t        penultimate_linear_layer: bool = True,\n96\t    ):\n97\t        super().__init__()\n98\t\n99\t        if pooling not in _VALID_POOLINGS:\n100\t            raise ValueError(f\"pooling must be one of {_VALID_POOLINGS}, got {pooling!r}\")\n101\t\n102\t        # Only \"class_token\" pooling prepends a global token to the backbone input (via\n103\t        # forward_with_cls_token, below); every other pooling must run with nglo=0 or the\n104\t        # long-short attention reshape fails. \"transformer\" pooling also uses a class token,\n105\t        # but concatenates it after the backbone, so it is not \"class_token\" here.\n106\t        nglo = 1 if pooling == \"class_token\" else 0\n107\t\n108\t        self.backbone = HelioSpectFormer(\n109\t            img_size=img_size,\n110\t            patch_size=patch_size,\n111\t            in_chans=in_chans,\n112\t            embed_dim=embed_dim,\n113\t            time_embedding=time_embedding,\n114\t            depth=depth,\n115\t            n_spectral_blocks=n_spectral_blocks,\n116\t            num_heads=num_heads,\n117\t            mlp_ratio=mlp_ratio,\n118\t            drop_rate=drop_rate,\n119\t            window_size=window_size,\n120\t            dp_rank=dp_rank,\n121\t            learned_flow=learned_flow,\n122\t            use_latitude_in_learned_flow=use_latitude_in_learned_flow,\n123\t            init_weights=init_weights,\n124\t            checkpoint_layers=checkpoint_layers,\n125\t            rpe=rpe,\n126\t            ensemble=ensemble,\n127\t            finetune=True,  # always strip the pretraining decoder\n128\t            dtype=dtype,\n129\t            nglo=nglo,\n130\t        )\n131\t\n132\t        self.pooling = pooling\n133\t        self.embed_dim = embed_dim\n134\t        self.head_dropout = nn.Dropout(dropout) if dropout > 0 else None\n135\t        self.penultimate_linear_layer_enabled = penultimate_linear_layer\n136\t\n137\t        if pooling == \"attention\":\n138\t            self.head_attn_pool = nn.MultiheadAttention(\n139\t                embed_dim, num_penultimate_heads, dropout=dropout\n140\t            )\n141\t\n142\t        elif pooling == \"transformer\":\n143\t            self.head_cls_token = ClassToken(embed_dim, init=\"randn\")\n144\t            encoder_layer = nn.TransformerEncoderLayer(\n145\t                d_model=embed_dim,\n146\t                nhead=num_penultimate_heads,\n147\t                dim_feedforward=embed_dim,\n148\t                dropout=dropout,\n149\t            )\n150\t            self.head_transformer = nn.TransformerEncoder(\n151\t                encoder_layer, num_layers=num_penultimate_transformer_layers\n152\t            )\n153\t\n154\t        elif pooling == \"class_token\":\n155\t            self.head_cls_token = ClassToken(embed_dim, init=\"zeros\")\n156\t\n157\t        if penultimate_linear_layer:\n158\t            self.head_linear = nn.Linear(embed_dim, embed_dim)\n159\t\n160\t        self.head_unembed = nn.Linear(embed_dim, num_outputs)\n161\t\n162\t    def forward(self, batch):\n163\t        if self.pooling == \"class_token\":\n164\t            # (1, 1, D) -- forward_with_cls_token expands it over the batch itself.\n165\t            tokens = self.backbone.forward_with_cls_token(batch, self.head_cls_token(1))\n166\t        else:\n167\t            tokens = self.backbone.forward(batch)\n168\t\n169\t        if self.penultimate_linear_layer_enabled:\n170\t            tokens = self.head_linear(tokens)\n171\t\n172\t        if self.pooling == \"global_average\":\n173\t            agg_tokens = torch.mean(tokens, dim=1)\n174\t        elif self.pooling == \"global_max\":\n175\t            agg_tokens, _ = torch.max(tokens, dim=1)\n176\t        elif self.pooling == \"attention\":\n177\t            tokens = tokens.permute(1, 0, 2)\n178\t            # Positional, not keyword: under PEFT this module is replaced by a\n179\t            # wrapper whose forward requires at least one positional argument.\n180\t            tokens, _ = self.head_attn_pool(tokens, tokens, tokens)\n181\t            agg_tokens = tokens.sum(dim=0)\n182\t        elif self.pooling == \"transformer\":\n183\t            B = tokens.size(0)\n184\t            tokens = torch.cat((self.head_cls_token(B), tokens), dim=1)\n185\t            tokens = self.head_transformer(tokens.permute(1, 0, 2))\n186\t            agg_tokens = tokens[0, :, :]\n187\t        elif self.pooling == \"class_token\":\n188\t            agg_tokens = tokens.squeeze(dim=1)\n189\t\n190\t        if self.head_dropout is not None:\n191\t            agg_tokens = self.head_dropout(agg_tokens)\n192\t\n193\t        return self.head_unembed(agg_tokens).squeeze(dim=1)\n194\t\n195\t    @classmethod\n196\t    def from_config(cls, cfg: \"ModelConfig\", **overrides) -> \"HelioSpectformer1D\":\n197\t        \"\"\"Construct from a ModelConfig, with optional field overrides.\n198\t\n199\t        Fields that live outside ModelConfig (e.g. ``dtype``,\n200\t        ``use_latitude_in_learned_flow``) should be supplied via ``overrides``.\n201\t        \"\"\"\n202\t        kwargs = dict(\n203\t            img_size=cfg.img_size,\n204\t            patch_size=cfg.patch_size,\n205\t            in_chans=cfg.in_channels,\n206\t            embed_dim=cfg.embed_dim,\n207\t            time_embedding=dataclasses.asdict(cfg.time_embedding),\n208\t            depth=cfg.depth,\n209\t            n_spectral_blocks=cfg.spectral_blocks,\n210\t            num_heads=cfg.num_heads,\n211\t            mlp_ratio=cfg.mlp_ratio,\n212\t            drop_rate=cfg.drop_rate,\n213\t            window_size=cfg.window_size,\n214\t            dp_rank=cfg.dp_rank,\n215\t            learned_flow=cfg.learned_flow,\n216\t            init_weights=cfg.init_weights,\n217\t            checkpoint_layers=cfg.checkpoint_layers,\n218\t            rpe=cfg.rpe,\n219\t            ensemble=cfg.ensemble,\n220\t            dropout=cfg.dropout,\n221\t            pooling=cfg.pooling,\n222\t            penultimate_linear_layer=cfg.penultimate_linear_layer,\n223\t        )\n224\t        kwargs.update(overrides)\n225\t        return cls(**kwargs)\n226\t\n227\t\n228\tclass HelioSpectformer2D(nn.Module):\n229\t    \"\"\"\n230\t    Fine-tuning wrapper for 2D outputs (e.g. image reconstruction or forecasting).\n231\t\n232\t    Holds a HelioSpectFormer backbone and adds a spatial decoder head on top.\n233\t\n234\t    As with HelioSpectformer1D, every trainable head component is a direct\n235\t    child whose name starts with ``head_`` -- see ``apply_peft_lora()``.\n236\t    \"\"\"\n237\t\n238\t    def __init__(\n239\t        self,\n240\t        # --- Backbone ---\n241\t        img_size: int,\n242\t        patch_size: int,\n243\t        in_chans: int,\n244\t        embed_dim: int,\n245\t        time_embedding: dict,\n246\t        depth: int,\n247\t        n_spectral_blocks: int,\n248\t        num_heads: int,\n249\t        mlp_ratio: float,\n250\t        drop_rate: float,\n251\t        window_size: int,\n252\t        dp_rank: int,\n253\t        learned_flow: bool = False,\n254\t        use_latitude_in_learned_flow: bool = False,\n255\t        init_weights: bool = False,\n256\t        dtype: torch.dtype = torch.bfloat16,\n257\t        checkpoint_layers: list[int] | None = None,\n258\t        rpe: bool = False,\n259\t        # --- Fine-tuning head ---\n260\t        ft_unembedding_type: str = \"linear\",\n261\t        ft_out_chans: int = 1,\n262\t    ):\n263\t        super().__init__()\n264\t\n265\t        self.backbone = HelioSpectFormer(\n266\t            img_size=img_size,\n267\t            patch_size=patch_size,\n268\t            in_chans=in_chans,\n269\t            embed_dim=embed_dim,\n270\t            time_embedding=time_embedding,\n271\t            depth=depth,\n272\t            n_spectral_blocks=n_spectral_blocks,\n273\t            num_heads=num_heads,\n274\t            mlp_ratio=mlp_ratio,\n275\t            drop_rate=drop_rate,\n276\t            window_size=window_size,\n277\t            dp_rank=dp_rank,\n278\t            learned_flow=learned_flow,\n279\t            use_latitude_in_learned_flow=use_latitude_in_learned_flow,\n280\t            init_weights=init_weights,\n281\t            dtype=dtype,\n282\t            checkpoint_layers=checkpoint_layers,\n283\t            rpe=rpe,\n284\t            finetune=True,  # always strip the pretraining decoder\n285\t        )\n286\t\n287\t        if ft_unembedding_type == \"linear\":\n288\t            self.head_unembed = LinearDecoder(\n289\t                patch_size=patch_size,\n290\t                out_chans=ft_out_chans,\n291\t                embed_dim=embed_dim,\n292\t            )\n293\t        elif ft_unembedding_type == \"perceiver\":\n294\t            self.head_unembed = PerceiverDecoder(\n295\t                embed_dim=embed_dim,\n296\t                patch_size=patch_size,\n297\t                out_chans=ft_out_chans,\n298\t            )\n299\t        else:\n300\t            raise ValueError(\n301\t                f\"ft_unembedding_type must be 'linear' or 'perceiver', got {ft_unembedding_type!r}\"\n302\t            )\n303\t\n304\t    def forward(self, batch):\n305\t        tokens = self.backbone.forward(batch)\n306\t        return self.head_unembed(tokens)  # (B, L, D) -> (B, C, H, W)\n307\t\n308\t    @classmethod\n309\t    def from_config(cls, cfg: \"ModelConfig\", **overrides) -> \"HelioSpectformer2D\":\n310\t        \"\"\"Construct from a ModelConfig, with optional field overrides.\n311\t\n312\t        Fields that live outside ModelConfig (e.g. ``dtype``,\n313\t        ``use_latitude_in_learned_flow``, ``ft_unembedding_type``,\n314\t        ``ft_out_chans``) should be supplied via ``overrides``.\n315\t        \"\"\"\n316\t        kwargs = dict(\n317\t            img_size=cfg.img_size,\n318\t            patch_size=cfg.patch_size,\n319\t            in_chans=cfg.in_channels,\n320\t            embed_dim=cfg.embed_dim,\n321\t            time_embedding=dataclasses.asdict(cfg.time_embedding),\n322\t            depth=cfg.depth,\n323\t            n_spectral_blocks=cfg.spectral_blocks,\n324\t            num_heads=cfg.num_heads,\n325\t            mlp_ratio=cfg.mlp_ratio,\n326\t            drop_rate=cfg.drop_rate,\n327\t            window_size=cfg.window_size,\n328\t            dp_rank=cfg.dp_rank,\n329\t            learned_flow=cfg.learned_flow,\n330\t            init_weights=cfg.init_weights,\n331\t            checkpoint_layers=cfg.checkpoint_layers,\n332\t            rpe=cfg.rpe,\n333\t        )\n334\t        kwargs.update(overrides)\n335\t        return cls(**kwargs)\n336\t",
