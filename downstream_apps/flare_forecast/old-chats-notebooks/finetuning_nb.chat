            "title": "cd surya_workshop && python - <<'EOF' import os, re, pandas as pd cache=\"/home/jovyan/scratch_space/surya_cache\" have=set() for f in os.listdir(cache): m=re.search(r\"__(\\d{8}_\\d{4})\\.nc$\", f) if m: have.add(pd.Timestamp(m.group(1).replace(\"_\",\"T\"))) for name in [\"surya_aws_s3_train.csv\",\"surya_aws_s3_val.csv\"]: p=f\"data/indices/{name}\" d=pd.read_csv(p) print(f\"\\n=== {name}: {len(d):,} rows, cols={list(d.columns)}\") print(d.head(2).to_string()) # find timestamp col tcol=[c for c in d.columns if \"time\" in c.lower() or \"date\" in c.lower()] print(\"time-ish cols:\", tcol) EOF",
