ses.items(): self.log(f\"{stage}_loss_{k}\", v, batch_size=self.batch_size, sync_dist=True) mets, mw = eval_fn(output, target) if len(mw) > 0: for k, v in mets.items(): self.log(f\"{stage}_metric_{k}\", v, batch_size=self.batch_size, sync_dist=True) return loss def training_step(self, batch, batch_idx): return self._step(batch, \"train\") def validation_step(self, batch, batch_idx): self._step(batch, \"val\") # ---- end cell 35 ---- class DS(Dataset): def __len__(self): return 4 def __getitem__(self, i): return { \"ts\": torch.randn(C, T, IMG, IMG), \"time_delta_input\": torch.tensor([-60.0, -36.0]), \"forecast\": torch.randn(C, 1, IMG, IMG), \"lead_time_delta\": torch.tensor([0.0]), \"ground_truth\": torch.tensor(1.0), \"ds_index\": \"2011-01-01T00:00:00\", \"was_flipped\": torch.tensor(False), } dl = DataLoader(DS(), batch_size=2) metrics = {'train_loss': FlareMetrics(\"train_loss\"), 'val_loss': FlareMetrics(\"val_loss\"), 'train_metrics': FlareMetrics(\"train_metrics\"), 'val_metrics': FlareMetrics(\"val_metrics\")} lit = Flare2DLightningModule(model, metrics, lr=1e-4, batch_size=2) print(\"INIT OK:\", type(lit).__name__) from lightning.pytorch.callbacks import ModelCheckpoint tr = L.Trainer(max_epochs=2, accelerator=\"cpu\", devices=1, logger=False, enable_progress_bar=False, enable_model_summary=False, callbacks=[ModelCheckpoint(monitor=\"val_loss\", mode=\"min\", save_top_k=1, dirpath=\"/tmp/ckpt_t\")], log_every_n_steps=1) tr.fit(lit, dl, dl) print(\"FIT OK. logged:\", {k: round(float(v),4) for k,v in tr.callback_metrics.items()}) print(\"best ckpt:\", tr.checkpoint_callback.best_model_path != \"\") EOF python t_lit.py 2>&1 | tail -35",
