            "kind": "execute",
            "title": "cd surya_workshop && cat > t_tol.py <<'PYEOF' import sys; sys.path.append(\".\") import numpy as np, pandas as pd from downstream_apps.flare_forecast.configs import load_flare_config from workshop_infrastructure.assets import ensure_assets from workshop_infrastructure.utils import build_scalers from downstream_apps.flare_forecast.datasets.flare_dataset import flare_Dataset from workshop_infrastructure.datasets.builders import build_helio_datasets cfg = load_flare_config(\"downstream_apps/flare_forecast/configs/config_script.yaml\") ensure_assets(cfg); scalers = build_scalers(info=cfg.data.scalers_path) tr, va = build_helio_datasets(cfg, flare_Dataset, scalers=scalers, return_surya_stack=True, max_number_of_samples=None, flip_probability=0.0, ds_flare_index_path=cfg.data.flare_index_path, ds_time_column=cfg.data.ds_time_column, ds_time_tolerance=cfg.data.ds_time_tolerance, ds_match_direction=cfg.data.ds_match_direction) pd.set_option(\"display.width\", 220) for name, d in ((\"TRAIN\", tr), (\"VAL\", va)): df = d.df_valid_indices.copy() gap = pd.to_timedelta(df[\"index_delta\"]).dt.total_seconds() / 60.0 # minutes cls = df[\"GOES_class\"].astype(str).str[0] yr = pd.DatetimeIndex(d.valid_indices).year print(f\"\\n================ {name} (n={len(df)}) ================\") print(\"gap = flare peak_time MINUS target frame time, in minutes\") print(f\" min {gap.min():.0f} | 25% {gap.quantile(.25):.0f} | median {gap.median():.0f} | \" f\"75% {gap.quantile(.75):.0f} | 90% {gap.quantile(.90):.0f} | 99% {gap.quantile(.99):.0f} | max {gap.max():.0f}\") rows = [] for label, mins in [(\"6m\",6),(\"12m\",12),(\"18m\",18),(\"30m\",30),(\"1h\",60),(\"2h\",120), (\"6h\",360),(\"12h\",720),(\"1d\",1440),(\"4d\",5760)]: k = gap <= mins rows.append(dict(tol=label, kept=int(k.sum()), pct=f\"{100*k.mean():.1f}%\", C=int((cls[k]==\"C\").sum()), M=int((cls[k]==\"M\").sum()), X=int((cls[k]==\"X\").sum()), y2014_15=int(((yr[k]>=2014)&(yr[k]<=2015)).sum()), y2023=int((yr[k]==2023).sum()))) print(pd.DataFrame(rows).to_string(index=False)) PYEOF python t_tol.py 2>&1 | grep -v \"FutureWarning\\|warnings.warn\"",
            "status": "completed",
            "raw_input": {
              "command": "cd /home/jovyan/tmp/surya_workshop && cat > /tmp/t_tol.py <<'PYEOF'\nimport sys; sys.path.append(\".\")\nimport numpy as np, pandas as pd\nfrom downstream_apps.flare_forecast.configs import load_flare_config\nfrom workshop_infrastructure.assets import ensure_assets\nfrom workshop_infrastructure.utils import build_scalers\nfrom downstream_apps.flare_forecast.datasets.flare_dataset import flare_Dataset\nfrom workshop_infrastructure.datasets.builders import build_helio_datasets\ncfg = load_flare_config(\"downstream_apps/flare_forecast/configs/config_script.yaml\")\nensure_assets(cfg); scalers = build_scalers(info=cfg.data.scalers_path)\ntr, va = build_helio_datasets(cfg, flare_Dataset, scalers=scalers,\n    return_surya_stack=True, max_number_of_samples=None, flip_probability=0.0,\n    ds_flare_index_path=cfg.data.flare_index_path, ds_time_column=cfg.data.ds_time_column,\n    ds_time_tolerance=cfg.data.ds_time_tolerance, ds_match_direction=cfg.data.ds_match_direction)\n\npd.set_option(\"display.width\", 220)\nfor name, d in ((\"TRAIN\", tr), (\"VAL\", va)):\n    df = d.df_valid_indices.copy()\n    gap = pd.to_timedelta(df[\"index_delta\"]).dt.total_seconds() / 60.0   # minutes\n    cls = df[\"GOES_class\"].astype(str).str[0]\n    yr  = pd.DatetimeIndex(d.valid_indices).year\n    print(f\"\\n================ {name}  (n={len(df)}) ================\")\n    print(\"gap = flare peak_time  MINUS  target frame time, in minutes\")\n    print(f\"  min {gap.min():.0f} | 25% {gap.quantile(.25):.0f} | median {gap.median():.0f} | \"\n          f\"75% {gap.quantile(.75):.0f} | 90% {gap.quantile(.90):.0f} | 99% {gap.quantile(.99):.0f} | max {gap.max():.0f}\")\n    rows = []\n    for label, mins in [(\"6m\",6),(\"12m\",12),(\"18m\",18),(\"30m\",30),(\"1h\",60),(\"2h\",120),\n                        (\"6h\",360),(\"12h\",720),(\"1d\",1440),(\"4d\",5760)]:\n        k = gap <= mins\n        rows.append(dict(tol=label, kept=int(k.sum()), pct=f\"{100*k.mean():.1f}%\",\n                         C=int((cls[k]==\"C\").sum()), M=int((cls[k]==\"M\").sum()), X=int((cls[k]==\"X\").sum()),\n                         y2014_15=int(((yr[k]>=2014)&(yr[k]<=2015)).sum()),\n                         y2023=int((yr[k]==2023).sum())))\n    print(pd.DataFrame(rows).to_string(index=False))\nPYEOF\n/home/jovyan/envs/surya_ws/bin/python /tmp/t_tol.py 2>&1 | grep -v \"FutureWarning\\|warnings.warn\""
