          {
            "title": "cd surya_workshop && python - <<'PYEOF' 2>&1 | grep -v \"FutureWarning\\|warnings.warn\" import sys; sys.path.append(\".\") import numpy as np, pandas as pd from downstream_apps.flare_forecast.configs import load_flare_config cfg = load_flare_config(\"downstream_apps/flare_forecast/configs/config_script.yaml\") cat = pd.read_csv(cfg.data.flare_index_path) for c in (\"start_time\",\"peak_time\",\"end_time\"): cat[c] = pd.to_datetime(cat[c]) cat[\"cls\"] = cat[\"GOES_class\"].astype(str).str[0] cat[\"rise_min\"] = (cat[\"peak_time\"] - cat[\"start_time\"]).dt.total_seconds()/60 cat[\"decay_min\"] = (cat[\"end_time\"] - cat[\"peak_time\"]).dt.total_seconds()/60 pd.set_option(\"display.width\",200) print(f\"full HEK catalog: {len(cat)} flares\\n\") print(\"START -> PEAK (rise time, minutes)\") g = cat.groupby(\"cls\")[\"rise_min\"] print(pd.DataFrame({\"n\":g.size(),\"mean\":g.mean(),\"median\":g.median(),\"25%\":g.quantile(.25), \"75%\":g.quantile(.75),\"90%\":g.quantile(.90),\"max\":g.max()}).round(1).to_string()) print(f\"\\nALL classes: mean {cat['rise_min'].mean():.1f} min | median {cat['rise_min'].median():.1f} min\") print(\"\\nPEAK -> END (decay, minutes)\") g2 = cat.groupby(\"cls\")[\"decay_min\"] print(pd.DataFrame({\"mean\":g2.mean(),\"median\":g2.median(),\"90%\":g2.quantile(.90)}).round(1).to_string()) print(\"\\nfraction of flares whose rise is shorter than one 12-min SDO cadence step:\") print(f\" {100*(cat['rise_min'] < 12).mean():.1f}% (<24 min: {100*(cat['rise_min'] < 24).mean():.1f}%)\") PYEOF",
            "raw_output": "full HEK catalog: 61210 flares\n\nSTART -> PEAK (rise time, minutes)\n         n  mean  median  25%   75%   90%      max\ncls                                               \nC    53616  13.3     6.0  3.0  10.0  20.0  21251.0\nM     7117  18.4     9.0  5.0  17.0  33.0   2065.0\nX      477  25.1    13.0  7.0  24.0  42.0   1223.0\n\nALL classes: mean 14.0 min | median 6.0 min\n\nPEAK -> END (decay, minutes)\n     mean  median    90%\ncls                     \nC     9.1     8.0   28.0\nM    24.2    17.0   63.0\nX    44.3    29.0  115.4\n\nfraction of flares whose rise is shorter than one 12-min SDO cadence step:\n  76.2%   (<24 min: 91.2%)\nShell cwd was reset to /home/jovyan/tmp/surya_workshop/downstream_apps/flare_forecast/old-chats-notebooks",
