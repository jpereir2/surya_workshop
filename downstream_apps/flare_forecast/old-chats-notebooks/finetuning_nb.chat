            "raw_input": {
              "run_in_background": true,
              "command": "cat > /tmp/run_flip_check.py <<'PYEOF'\n# Mirrors the notebook's minimum path: cells 2,3,5,7,10,11,17,19,21,23 then cell 29 parts A+B.\nimport os, sys, time\nos.environ[\"CUDA_VISIBLE_DEVICES\"] = \"0\"\nos.environ.setdefault(\"CUBLAS_WORKSPACE_CONFIG\", \":4096:8\")\n\nimport torch\nsys.path.append(\"../../\")\nfrom workshop_infrastructure.utils import build_scalers, load_pretrained_weights\ntorch.set_float32_matmul_precision(\"medium\")\n\nT0 = time.time()\ndef log(msg): print(f\"[{time.time()-T0:7.1f}s] {msg}\", flush=True)\n\n# ---- cell 5\nfrom downstream_apps.flare_forecast.configs import load_flare_config\ncfg = load_flare_config(\"./configs/config_script.yaml\")\nlog(f\"config: job={cfg.job_id}  batch_size={cfg.batch_size}  dtype={cfg.dtype}\")\n\n# ---- cell 7\nfrom workshop_infrastructure.assets import ensure_assets\nensure_assets(cfg, which=[\"scalers\", \"weights\"])\nscalers = build_scalers(info=cfg.data.scalers_path)\nlog(f\"scalers for {len(scalers)} channels\")\n\n# ---- cells 10, 11  (max_number_of_samples=2 for the minimum check)\nfrom downstream_apps.flare_forecast.datasets.flare_dataset import flare_Dataset\nfrom workshop_infrastructure.datasets.builders import build_helio_dataloaders\ntrain_data_loader, val_data_loader = build_helio_dataloaders(\n    cfg, flare_Dataset, scalers=scalers, num_workers=0,\n    return_surya_stack=True,\n    max_number_of_samples=2,\n    flip_probability=0.5,\n    ds_flare_index_path=cfg.data.flare_index_path,\n    ds_time_column=cfg.data.ds_time_column,\n    ds_time_tolerance=cfg.data.ds_time_tolerance,\n    ds_match_direction=cfg.data.ds_match_direction,\n)\nlog(f\"train {len(train_data_loader.dataset)} | val {len(val_data_loader.dataset)} samples\")\n\n# ---- cells 17, 19\nfrom workshop_infrastructure.models.finetune_models import HelioSpectformer2D\nmodel = HelioSpectformer2D.from_config(\n    cfg.model,\n    ft_out_chans=len(cfg.data.channels),\n    ft_unembedding_type=\"linear\",\n    dtype=cfg.dtype,\n    use_latitude_in_learned_flow=cfg.use_latitude_in_learned_flow,\n)\nlog(\"model built\")\n\n# ---- cell 21\nload_pretrained_weights(model, cfg.model.pretrained_path)\n\n# ---- cell 23  (the decoder fix)\n_ckpt = torch.load(cfg.model.pretrained_path, weights_only=True, map_location=\"cpu\")\n_msd = model.state_dict()\n_copied = []\nfor _k, _v in _ckpt.items():\n    _target = f\"head_{_k}\"\n    if _target in _msd:\n        assert _v.shape == _msd[_target].shape, f\"shape mismatch {_target}\"\n        _msd[_target] = _v\n        _copied.append((_k, _target, tuple(_v.shape)))\nassert _copied, f\"no head_* match; unembed keys = {[k for k in _ckpt if k.startswith('unembed')]}\"\nmodel.load_state_dict(_msd, strict=True)\nlog(f\"decoder fix copied {len(_copied)} tensors: \" + \", \".join(f\"{k}->{t} {s}\" for k, t, s in _copied))\ndel _ckpt, _msd\n\n# ---- cell 29, parts A and B\nimport numpy as np, pandas as pd\ndev = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n_KEYS = (\"ts\", \"time_delta_input\", \"lead_time_delta\")\nmse = lambda a, b: torch.mean((a.float() - b.float()) ** 2).item()\n\ndef as_batch(sample):\n    b = {k: torch.as_tensor(sample[k])[None].to(dev) for k in _KEYS}\n    tgt = torch.as_tensor(sample[\"forecast\"])[None][:, :, 0].to(dev)\n    return b, tgt\n\nds = train_data_loader.dataset\nds.flip_probability = 0.0\ns_up = ds[0]\nlog(\"read sample 0 upright\")\nds.flip_probability = 1.0\ns_fl = ds[0]\nlog(\"read sample 0 flipped\")\n\nassert not s_up[\"was_flipped\"], \"p=0.0 still reported was_flipped=True\"\nassert s_fl[\"was_flipped\"], \"p=1.0 did not report was_flipped=True\"\nassert np.array_equal(s_fl[\"ts\"], np.flip(s_up[\"ts\"], axis=-2)), \"input not flipped as expected\"\nassert np.array_equal(s_fl[\"forecast\"], np.flip(s_up[\"forecast\"], axis=-2)), \\\n    \"TARGET not flipped with the input\"\nprint(\"\\nA. PASS - flip fires, is recorded in was_flipped, and flips BOTH input and target.\\n\", flush=True)\ndel s_up, s_fl\n\nmodel = model.to(dev).eval()\nrows = []\nfor split, dl in ((\"train\", train_data_loader), (\"val\", val_data_loader)):\n    d = dl.dataset\n    d.flip_probability = 0.0\n    for i in range(len(d)):\n        s = d[i]\n        b, tgt = as_batch(s)\n        for orient in (\"upright\", \"flipped\"):\n            bb, t = dict(b), tgt\n            if orient == \"flipped\":\n                bb[\"ts\"] = torch.flip(b[\"ts\"], dims=[-2])\n                t = torch.flip(tgt, dims=[-2])\n            t0 = time.perf_counter()\n            with torch.no_grad(), torch.autocast(device_type=dev, dtype=torch.bfloat16):\n                pred = model(bb).float()\n            if dev == \"cuda\": torch.cuda.synchronize()\n            rows.append({\"split\": split, \"i\": i, \"time\": s[\"ds_index\"][:16],\n                         \"orientation\": orient, \"error\": mse(pred, t),\n                         \"persistence\": mse(bb[\"ts\"][:, :, -1], t)})\n            log(f\"B: {split} {i} {orient:8s} fwd {time.perf_counter()-t0:5.1f}s \"\n                f\"err {rows[-1]['error']:.4f}\")\n            del bb, t, pred\n        del b, tgt\n\ntab = pd.DataFrame(rows)\nprint(\"\\n\" + tab.to_string(index=False), flush=True)\nprint(\"\\n\" + tab.groupby([\"split\", \"orientation\"])[[\"error\", \"persistence\"]].mean().to_string())\n\n_p = tab.pivot_table(index=[\"split\", \"i\"], columns=\"orientation\", values=\"persistence\")\n_gap = (_p[\"upright\"] - _p[\"flipped\"]).abs().max()\nprint(f\"\\npersistence gap across orientations: {_gap:.3e}  (must be ~0)\")\nassert _gap < 1e-4, f\"persistence differs by {_gap:.2e} -- flip inconsistent\"\n\n_m = tab.pivot_table(index=[\"split\", \"i\"], columns=\"orientation\", values=\"error\")\nprint(f\"mean error, flipped minus upright: {(_m['flipped'] - _m['upright']).mean():+.4f}\")\nprint(\"per-sample flipped minus upright:\")\nprint((_m[\"flipped\"] - _m[\"upright\"]).to_string())\nif dev == \"cuda\":\n    print(f\"\\npeak GPU memory: {torch.cuda.max_memory_allocated()/2**30:.1f} GB of \"\n          f\"{torch.cuda.get_device_properties(0).total_memory/2**30:.0f} GB\")\nlog(\"DONE\")\nPYEOF\ncd /home/jovyan/tmp/surya_workshop/downstream_apps/flare_forecast && /home/jovyan/envs/surya_ws/bin/python /tmp/run_flip_check.py 2>&1 | tail -60",
