            "tool_call_id": "toolu_bdrk_01CW8NSxKdSW3bSk6QMpbvyS",
            "title": "cd surya_workshop && cat > t_barplot.py <<'PYEOF' import sys; sys.path.append(\".\") import matplotlib; matplotlib.use(\"Agg\") from downstream_apps.flare_forecast.configs import load_flare_config from workshop_infrastructure.assets import ensure_assets from workshop_infrastructure.utils import build_scalers from downstream_apps.flare_forecast.datasets.flare_dataset import flare_Dataset cfg = load_flare_config(\"downstream_apps/flare_forecast/configs/config_script.yaml\") ensure_assets(cfg); scalers = build_scalers(info=cfg.data.scalers_path) # ===================== CELL TO PASTE STARTS HERE ===================== # Flares per year in the train and val splits, uncapped by N_SAMPLES. # Index matching only -- no NetCDF is read -- so this takes a few seconds. import numpy as np, pandas as pd, matplotlib.pyplot as plt from workshop_infrastructure.datasets.builders import build_helio_datasets _splits = build_helio_datasets( cfg, flare_Dataset, scalers=scalers, return_surya_stack=True, max_number_of_samples=None, flip_probability=0.0, ds_flare_index_path=cfg.data.flare_index_path, ds_time_column=cfg.data.ds_time_column, ds_time_tolerance=cfg.data.ds_time_tolerance, ds_match_direction=cfg.data.ds_match_direction, ) counts = {} for _name, _d in zip((\"train\", \"val\"), _splits): _t = pd.DatetimeIndex(_d.valid_indices) counts[_name] = _t.year.value_counts() del _splits # Show every year in the range so the missing ones (2012, 2022) are visible as gaps. years = np.arange(min(c.index.min() for c in counts.values()), max(c.index.max() for c in counts.values()) + 1) train = counts[\"train\"].reindex(years, fill_value=0) val = counts[\"val\"].reindex(years, fill_value=0) fig, axes = plt.subplots(2, 1, figsize=(11, 6.5), sharex=True, gridspec_kw={\"height_ratios\": [2, 1], \"hspace\": 0.12}) for ax, series, label, color in ( (axes[0], train, f\"TRAIN ({train.sum():,} flares, Mar\u2013Dec)\", \"#2b6cb0\"), (axes[1], val, f\"VAL ({val.sum():,} flares, Jan 16\u201330 only)\", \"#c05621\"), ): bars = ax.bar(years, series.values, color=color, width=0.72) for x, v in zip(years, series.values): ax.annotate(\"0\" if v == 0 else f\"{v:,}\", (x, v), textcoords=\"offset points\", xytext=(0, 3), ha=\"center\", fontsize=8, color=\"crosshatch\" if False else (\"#999999\" if v == 0 else \"black\")) ax.set_ylabel(\"flares\") ax.set_title(label, loc=\"left\", fontsize=11, fontweight=\"bold\", color=color) ax.set_ylim(0, series.max() * 1.18) ax.grid(axis=\"y\", alpha=0.3) ax.spines[[\"top\", \"right\"]].set_visible(False) axes[1].set_xticks(years) axes[1].set_xticklabels(years, rotation=45, ha=\"right\") axes[1].set_xlabel(\"year\") fig.suptitle(\"Flares available per year, Surya train/val split \" f\"(matched on {cfg.data.ds_time_column}, tolerance {cfg.data.ds_time_tolerance})\", fontsize=12, y=0.98) plt.show() print(pd.DataFrame({\"train\": train, \"val\": val}).T.to_string()) # ====================== CELL TO PASTE ENDS HERE ====================== plt.savefig(\"/tmp/flares_per_year.png\", dpi=110, bbox_inches=\"tight\") print(\"saved\") PYEOF python t_barplot.py 2>&1 | grep -v \"FutureWarning\\|warnings.warn\""
