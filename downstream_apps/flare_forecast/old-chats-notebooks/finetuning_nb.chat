              "command": "cd /home/jovyan/tmp/surya_workshop && grep -n \"phase\\|drop_hmi\\|mask\\|random_vert\\|flip\" workshop_infrastructure/datasets/helio.py | head -60"
            },
            "raw_output": "7:  masking, and transparent local/S3 file access.\n269:# Channel masking transform\n279:        num_mask_aia_channels: Number of AIA channels to randomly zero-out per sample.\n280:        phase: Dataset phase (e.g., ``\"train\"``). Included for future phase-specific logic.\n281:        drop_hmi_probability: Probability of zeroing the last (HMI) channel.\n284:    def __init__(self, num_channels, num_mask_aia_channels, phase, drop_hmi_probability):\n286:        self.num_mask_aia_channels = num_mask_aia_channels\n287:        self.drop_hmi_probability = drop_hmi_probability\n290:        \"\"\"Apply random channel masking to a (C, T, H, W) image stack.\n292:        Zeros out ``num_mask_aia_channels`` randomly chosen channels uniformly across all\n294:        ``drop_hmi_probability``.\n304:        channels_to_mask = random.sample(range(C), self.num_mask_aia_channels)\n305:        mask = torch.ones((C, 1, 1, 1))\n306:        mask[channels_to_mask, ...] = 0\n307:        masked_tensor = input_tensor * mask\n309:        if self.drop_hmi_probability > random.random():\n310:            masked_tensor[-1, ...] = 0\n312:        return masked_tensor\n354:        num_mask_aia_channels: Number of AIA channels to randomly mask during training.\n355:        drop_hmi_probability: Probability of dropping the HMI channel during training.\n358:        phase: Dataset phase label (e.g., ``\"train\"``, ``\"val\"``).\n360:        random_vert_flip: If True, randomly flip images vertically during training.\n404:        num_mask_aia_channels: int = 0,\n405:        drop_hmi_probability: float = 0.0,\n408:        phase: str = \"train\",\n410:        random_vert_flip: bool = False,\n426:        self.phase = phase\n427:        self.num_mask_aia_channels = num_mask_aia_channels\n428:        self.drop_hmi_probability = drop_hmi_probability\n433:        self.random_vert_flip = random_vert_flip\n471:        self.masker = RandomChannelMaskerTransform(\n473:            num_mask_aia_channels=self.num_mask_aia_channels,\n474:            phase=self.phase,\n475:            drop_hmi_probability=self.drop_hmi_probability,\n556:            name=f\"{timestamp}_{self.rank:>03}_data_{self.phase}_{pid}\",\n612:        applies channel masking and optional vertical flip, then assembles the sample\n628:        if self.num_mask_aia_channels > 0 or self.drop_hmi_probability:\n629:            stacked_inputs = self.masker(stacked_inputs)\n650:        if self.random_vert_flip and torch.bernoulli(torch.ones(()) / 2) == 1:\n651:            sample[\"ts\"] = np.flip(sample[\"ts\"], axis=-2).copy()\n653:                sample[\"forecast\"] = np.flip(sample[\"forecast\"], axis=-2).copy()\nShell cwd was reset to /home/jovyan/tmp/surya_workshop/downstream_apps/flare_forecast/old-chats-notebooks",
