      "raw_time": false,
      "metadata": {
        "tool_calls": [
          {
            "session_id": "86e6be9a-1e6b-4679-972f-8d7b8a07afbb",
            "diffs": [
              {
                "path": "/tmp/insert_cells.py",
                "new_text": "import json, copy\n\nNB = \"/home/jovyan/tmp/surya_workshop/downstream_apps/flare_forecast/2_finetune_2D-image-flip.ipynb\"\nnb = json.load(open(NB))\n\ndef md(text):\n    return {\"cell_type\": \"markdown\", \"metadata\": {}, \"source\": text.strip(\"\\n\").splitlines(keepends=True)}\n\ndef code(text):\n    return {\"cell_type\": \"code\", \"execution_count\": None, \"metadata\": {}, \"outputs\": [],\n            \"source\": text.strip(\"\\n\").splitlines(keepends=True)}\n\n\n# ---------------------------------------------------------------- CHECK 1\nMD_SPEED = \"\"\"\n### Speed check: is the bottleneck S3 or the GPU?\n\nWith `s3_mode: download`, each sample pulls **three** NetCDF files (~0.5 GB each) from S3 the\nfirst time it is visited, then reads them from `s3_cache_dir` forever after. When that happens\n*inside* the training loop, the GPU idles through the download \u2014 which is what a flat WandB\nGPU-utilization trace with one brief spike per step looks like.\n\nThe cell below walks each dataset twice. **Pass 1 is cold** (downloads, and leaves the files\ncached). **Pass 2 is warm** (local disk only). Two things come out of it:\n\n* The cache is now warm, so the training run below is not competing with the network.\n* The cold/warm ratio tells you which resource you are actually short of, which decides how\n  much data the real runs can afford.\n\"\"\"\n\nCODE_SPEED = '''\n# Walk every sample twice: pass 1 downloads and caches, pass 2 reads from local disk.\n# Each sample is loaded, normalized, then discarded, so only one (~2.6 GB) is held at a time.\nimport time\n\ndef walk(ds, label):\n    per = []\n    for i in range(len(ds)):\n        t = time.perf_counter()\n        _ = ds[i]                              # load + normalize, then let it go\n        per.append(time.perf_counter() - t)\n        print(f\"\\\\r  {label}: {i+1}/{len(ds)}   last {per[-1]:6.1f}s   \"\n              f\"mean {sum(per)/len(per):6.1f}s\", end=\"\", flush=True)\n    print()\n    return sum(per) / len(per)\n\nfor _name, _dl in ((\"train\", train_data_loader), (\"val\", val_data_loader)):\n    _cold = walk(_dl.dataset, f\"{_name} cold\")\n    _warm = walk(_dl.dataset, f\"{_name} warm\")\n    print(f\"  -> {_name}: {_cold:.1f}s/sample cold, {_warm:.1f}s/sample warm \"\n          f\"({_cold/max(_warm, 1e-9):.1f}x faster once cached)\\\\n\")\n\nprint(\"If warm is much faster than cold, S3 was the bottleneck: warm the cache for every\")\nprint(\"sample you plan to use BEFORE training, and num_workers=2 then becomes safe.\")\nprint(\"If warm is about the same, the GPU is the limit: shorten model.checkpoint_layers.\")\n'''\n\n# ---------------------------------------------------------------- DECODER FIX\nMD_DECODER = \"\"\"\n### Load the image decoder that `load_pretrained_weights()` misses\n\nThe cell above reports **157 / 159**. The two missing tensors are the model's *final layer* \u2014\nthe one that converts Surya's internal representation (65,536 patches x 1,280 numbers) back\ninto a 13-channel image.\n\nThe checkpoint stores that layer as `unembed.*`. Our model calls it `head_unembed.*`, because\n`apply_peft_lora()` finds trainable head modules by the `head_` prefix. But\n`load_pretrained_weights()` only tries the key as-is and with a `backbone.` prefix\n(`workshop_infrastructure/utils.py:404`), so these two are dropped **without a warning** and\nthe layer starts as random numbers.\n\nThat is why a prediction looks foggy and dim, and why the loss parks near 1.0: in normalized\nspace every channel has mean 0 and standard deviation 1, so \"predict the average and give up\"\nscores almost exactly 1.0. The body of the model knows the Sun; the last step was guessing.\n\n**This cell must run before the LoRA cell** \u2014 `apply_peft_lora()` rewrites parameter names.\n\"\"\"\n\nCODE_DECODER = '''\n# Copy the two decoder tensors load_pretrained_weights() could not find, by trying the\n# \"head_\" prefix it never tries. Asserts rather than warns: a silent miss here is exactly\n# the failure mode we are fixing.\n_ckpt = torch.load(cfg.model.pretrained_path, weights_only=True, map_location=\"cpu\")\n_msd = model.state_dict()\n\n_copied = []\nfor _k, _v in _ckpt.items():\n    _target = f\"head_{_k}\"          # \"unembed.unembed.0.weight\" -> \"head_unembed.unembed.0.weight\"\n    if _target in _msd:\n        assert _v.shape == _msd[_target].shape, (\n            f\"shape mismatch for {_target}: checkpoint {tuple(_v.shape)} vs \"\n            f\"model {tuple(_msd[_target].shape)}. Check ft_out_chans == len(cfg.data.channels).\"\n        )\n        _msd[_target] = _v\n        _copied.append((_k, _target, tuple(_v.shape)))\n\nassert _copied, (\n    \"No checkpoint key matched head_*. Expected 'unembed.unembed.0.weight'. \"\n    f\"Checkpoint keys beginning with 'unembed': {[k for k in _ckpt if k.startswith('unembed')]}\"\n)\n\nmodel.load_state_dict(_msd, strict=True)\nprint(f\"Copied {len(_copied)} decoder tensors the loader missed:\")\nfor _k, _target, _shape in _copied:\n    print(f\"    {_k}  ->  {_target}   {_shape}\")\nprint(\"\\\\n3328 = 16*16 patch pixels x 13 channels, so this really is our LinearDecoder.\")\ndel _ckpt, _msd\n'''\n\n# ---------------------------------------------------------------- CHECK 2\nMD_FLIP = \"\"\"\n### Forced flip pass: does a flipped stack reach the model, and does it cost more?\n\nThis is the plumbing check for the whole project. It takes **one** sample and pushes it\nthrough the model twice \u2014 upright, and vertically flipped the same way `flare_dataset.py`\nflips it (`axis=-2`, i.e. north-south). It answers:\n\n1. **Does the flip actually reach the model?** Asserted two ways: flipping twice must return\n   the original, and the flipped input must differ from the upright one.\n2. **Does a flipped input take longer?** It should not. The model performs identical\n   arithmetic no matter what the pixel values are \u2014 no data-dependent branching, no shortcut\n   for dark pixels. A ratio near **1.00** is the correct result, not a broken test.\n3. **How much does the flip change the model's answer?** Un-flip the flipped prediction and\n   compare it to the upright prediction. Near 0 means the model is blind to orientation, so\n   Hale's law cannot explain a cycle-25 failure. Large means its answer genuinely depends on\n   orientation \u2014 your hypothesis is live. This is the single number the project turns on, and\n   you get it here for free, before any training.\n4. **What does one real training step cost?** Forward + backward + optimizer at the current\n   `checkpoint_layers`. Every time estimate for the overnight runs rests on this number, so\n   measure it rather than trusting an estimate.\n\nIt puts the model back on the CPU at the end, so nothing downstream is affected. Cell 23's\nCPU forward pass becomes redundant once this runs \u2014 skip it.\n\"\"\"\n\nCODE_FLIP = '''\n# Force one upright and one flipped pass through the model, then time a real training step.\nimport time\n\ndev = \"cuda\" if torch.cuda.is_available() else \"cpu\"\nchk_batch = next(iter(train_data_loader))\n\n# The backbone reads only these three keys (helio_spectformer.py:258-269), so moving just\n# them keeps the 0.9 GB forecast tensor off the GPU during the forward-only tests.\n_KEYS = (\"ts\", \"time_delta_input\", \"lead_time_delta\")\nup = {k: chk_batch[k][:1].to(dev) for k in _KEYS}\ntarget_up = chk_batch[\"forecast\"][:1, :, 0].float().to(dev)   # (1, 13, 4096, 4096)\n\n# The same vertical flip flare_dataset.py:151 applies. ts is (B, C, T, H, W), so -2 is H.\n_t = time.perf_counter()\nfl = dict(up)\nfl[\"ts\"] = torch.flip(up[\"ts\"], dims=[-2])\n_flip_ms = (time.perf_counter() - _t) * 1e3\n\nassert torch.equal(torch.flip(fl[\"ts\"], dims=[-2]), up[\"ts\"]), \"flip is not its own inverse\"\nassert not torch.equal(fl[\"ts\"], up[\"ts\"]), \"flipped input equals upright \u2014 the flip did nothing\"\nprint(f\"flip verified (is its own inverse, and does change the data); cost {_flip_ms:.0f} ms\\\\n\")\n\nmodel = model.to(dev).eval()\n\ndef timed(b, label, reps=2):\n    with torch.no_grad(), torch.autocast(device_type=dev, dtype=torch.bfloat16):\n        out = model(b)                                   # warm-up: first call has one-off cost\n        if dev == \"cuda\": torch.cuda.synchronize()\n        best = float(\"inf\")\n        for _ in range(reps):\n            _t = time.perf_counter()\n            out = model(b)\n            if dev == \"cuda\": torch.cuda.synchronize()\n            best = min(best, time.perf_counter() - _t)\n    print(f\"  {label:8s} forward {best:6.2f} s    output {tuple(out.shape)}\")\n    return best, out.float()\n\nt_up, pred_up = timed(up, \"upright\")\nt_fl, pred_fl = timed(fl, \"flipped\")\n\n_mse = lambda a, b: torch.mean((a - b) ** 2).item()\nprint(f\"\\\\nflipped / upright time ratio           : {t_fl / t_up:.3f}    (expect ~1.0)\")\nprint(f\"error vs ground truth, upright input   : {_mse(pred_up, target_up):.4f}\")\nprint(f\"error of just copying the last input   : {_mse(up['ts'][:, :, -1].float(), target_up):.4f}\"\n      \"   <- persistence baseline: beat this or there is no forecast skill\")\nprint(f\"how much the flip changed the answer   : {_mse(torch.flip(pred_fl, dims=[-2]), pred_up):.4f}\"\n      \"   <- ~0: model is blind to orientation; large: orientation matters\")\n\n# One real training step at the current checkpoint_layers setting.\nmodel.train()\n_opt = torch.optim.Adam([p for p in model.parameters() if p.requires_grad], lr=1e-4)\nif dev == \"cuda\": torch.cuda.reset_peak_memory_stats()\n_steps = []\nfor _ in range(2):\n    _t = time.perf_counter()\n    with torch.autocast(device_type=dev, dtype=torch.bfloat16):\n        _loss = torch.nn.functional.mse_loss(model(up).float(), target_up)\n    _loss.backward()\n    _opt.step()\n    _opt.zero_grad(set_to_none=True)\n    if dev == \"cuda\": torch.cuda.synchronize()\n    _steps.append(time.perf_counter() - _t)\n\n_step = min(_steps)\nprint(f\"\\\\ntraining step, batch 1 : {_step:.1f} s  ->  {3600/_step:.0f} sample-views per GPU-hour\")\nprint(f\"                        so a 150-sample x 2-epoch run is about {300*_step/3600:.1f} hours\")\nif dev == \"cuda\":\n    _peak = torch.cuda.max_memory_allocated() / 2**30\n    _tot = torch.cuda.get_device_properties(0).total_memory / 2**30\n    print(f\"peak GPU memory        : {_peak:.1f} GB of {_tot:.0f} GB\")\n    print(f\"model.checkpoint_layers: {cfg.model.checkpoint_layers}\")\n    print(\"  Those layers recompute their activations during backward to save memory, at\"\n          \" roughly 30-40% extra compute.\")\n    print(f\"  You are using {_peak:.0f} of {_tot:.0f} GB, so shortening that list (try [0,1,2,3,4])\"\n          \" should give faster steps for free.\")\n\n# Leave the notebook exactly as it was, so cell order does not matter.\ndel _opt, _loss, pred_up, pred_fl, up, fl, target_up, chk_batch\nmodel = model.to(\"cpu\").train()\nif dev == \"cuda\": torch.cuda.empty_cache()\nprint(\"\\\\nModel returned to CPU; Lightning will move it back to the GPU during fit().\")\n'''\n\n# Sanity: the anchors must be where we think they are.\ndef head(i):\n    return \"\".join(nb[\"cells\"][i][\"source\"])[:70]\n\nassert \"Inspect a single batch\" in head(13), head(13)\nassert \"checkpoint was saved from HelioSpectFormer\" in head(19), head(19)\nassert \"Three fine-tuning regimes\" in head(21), head(21)\n\n# Insert bottom-up so the earlier anchor indices stay valid.\nnb[\"cells\"][22:22] = [md(MD_FLIP), code(CODE_FLIP)]\nnb[\"cells\"][20:20] = [md(MD_DECODER), code(CODE_DECODER)]\nnb[\"cells\"][14:14] = [md(MD_SPEED), code(CODE_SPEED)]\n\njson.dump(nb, open(NB, \"w\"), indent=1)\nprint(f\"wrote {NB}: {len(nb['cells'])} cells\")\nfor i, c in enumerate(nb[\"cells\"]):\n    s = \"\".join(c[\"source\"]).strip().split(\"\\n\")\n    print(f\"{i:3d} {c['cell_type'][:4]:4s} | {(s[0] if s else '(empty)')[:78]}\")\n"
              }
