          {
            "title": "cd surya_workshop && python - <<'PYEOF' 2>&1 | grep -v \"FutureWarning\\|warnings.warn\" import sys; sys.path.append(\".\") import numpy as np, pandas as pd from downstream_apps.flare_forecast.configs import load_flare_config from workshop_infrastructure.assets import ensure_assets from workshop_infrastructure.utils import build_scalers from downstream_apps.flare_forecast.datasets.flare_dataset import flare_Dataset from workshop_infrastructure.datasets.builders import build_helio_datasets cfg = load_flare_config(\"downstream_apps/flare_forecast/configs/config_script.yaml\") ensure_assets(cfg); scalers = build_scalers(info=cfg.data.scalers_path) tr, va = build_helio_datasets(cfg, flare_Dataset, scalers=scalers, return_surya_stack=True, max_number_of_samples=None, flip_probability=0.0, ds_flare_index_path=cfg.data.flare_index_path, ds_time_column=cfg.data.ds_time_column, ds_time_tolerance=\"12m\", ds_match_direction=cfg.data.ds_match_direction) pd.set_option(\"display.width\",200) for name, d in ((\"TRAIN\", tr), (\"VAL\", va)): df = d.df_valid_indices.copy() ref = pd.DatetimeIndex(d.valid_indices) # = the TARGET frame now = ref + pd.Timedelta(minutes=sorted(cfg.data.time_delta_input_minutes)[-1]) old = ref + pd.Timedelta(minutes=sorted(cfg.data.time_delta_input_minutes)[0]) start = pd.DatetimeIndex(pd.to_datetime(df[\"start_time\"])) peak = pd.DatetimeIndex(pd.to_datetime(df[\"peak_time\"])) m = lambda a, b: ((a - b).total_seconds()/60) out = pd.DataFrame({ \"rise start->peak\": m(peak, start), \"target frame -> peak\": m(peak, ref), \"target frame -> start\": m(start, ref), \"now frame -> start\": m(start, now), \"now frame -> peak\": m(peak, now), \"1st input -> peak\": m(peak, old), }) print(f\"\\n===== {name} (n={len(df)}, tolerance 12m) ===== minutes; positive = event is AFTER the frame\") print(out.describe(percentiles=[.1,.25,.5,.75,.9]).round(1).T.to_string()) print(f\" fraction of samples where the flare had NOT yet started at the 'now' input frame: \" f\"{100*(out['now frame -> start'] > 0).mean():.1f}%\") print(f\" fraction where it had NOT started at the TARGET frame: \" f\"{100*(out['target frame -> start'] > 0).mean():.1f}%\") PYEOF",
            "kind": "execute",
            "tool_call_id": "toolu_bdrk_01LMrPAqd9MzUHsG8zpg5T6V",
            "status": "completed",
            "raw_input": {
              "command": "cd /home/jovyan/tmp/surya_workshop && /home/jovyan/envs/surya_ws/bin/python - <<'PYEOF' 2>&1 | grep -v \"FutureWarning\\|warnings.warn\"\nimport sys; sys.path.append(\".\")\nimport numpy as np, pandas as pd\nfrom downstream_apps.flare_forecast.configs import load_flare_config\nfrom workshop_infrastructure.assets import ensure_assets\nfrom workshop_infrastructure.utils import build_scalers\nfrom downstream_apps.flare_forecast.datasets.flare_dataset import flare_Dataset\nfrom workshop_infrastructure.datasets.builders import build_helio_datasets\ncfg = load_flare_config(\"downstream_apps/flare_forecast/configs/config_script.yaml\")\nensure_assets(cfg); scalers = build_scalers(info=cfg.data.scalers_path)\ntr, va = build_helio_datasets(cfg, flare_Dataset, scalers=scalers,\n    return_surya_stack=True, max_number_of_samples=None, flip_probability=0.0,\n    ds_flare_index_path=cfg.data.flare_index_path, ds_time_column=cfg.data.ds_time_column,\n    ds_time_tolerance=\"12m\", ds_match_direction=cfg.data.ds_match_direction)\npd.set_option(\"display.width\",200)\nfor name, d in ((\"TRAIN\", tr), (\"VAL\", va)):\n    df = d.df_valid_indices.copy()\n    ref = pd.DatetimeIndex(d.valid_indices)                 # = the TARGET frame\n    now = ref + pd.Timedelta(minutes=sorted(cfg.data.time_delta_input_minutes)[-1])\n    old = ref + pd.Timedelta(minutes=sorted(cfg.data.time_delta_input_minutes)[0])\n    start = pd.DatetimeIndex(pd.to_datetime(df[\"start_time\"]))\n    peak  = pd.DatetimeIndex(pd.to_datetime(df[\"peak_time\"]))\n    m = lambda a, b: ((a - b).total_seconds()/60)\n    out = pd.DataFrame({\n        \"rise start->peak\":      m(peak, start),\n        \"target frame -> peak\":  m(peak, ref),\n        \"target frame -> start\": m(start, ref),\n        \"now frame -> start\":    m(start, now),\n        \"now frame -> peak\":     m(peak, now),\n        \"1st input -> peak\":     m(peak, old),\n    })\n    print(f\"\\n===== {name} (n={len(df)}, tolerance 12m) =====   minutes; positive = event is AFTER the frame\")\n    print(out.describe(percentiles=[.1,.25,.5,.75,.9]).round(1).T.to_string())\n    print(f\"  fraction of samples where the flare had NOT yet started at the 'now' input frame: \"\n          f\"{100*(out['now frame -> start'] > 0).mean():.1f}%\")\n    print(f\"  fraction where it had NOT started at the TARGET frame: \"\n          f\"{100*(out['target frame -> start'] > 0).mean():.1f}%\")\nPYEOF"
            },
            "raw_output": "===== TRAIN (n=6026, tolerance 12m) =====   minutes; positive = event is AFTER the frame\n                        count  mean    std      min   10%   25%   50%   75%   90%      max\nrise start->peak       6026.0  14.2  218.8  -1429.0   4.0   5.0   7.0  13.0  25.0  16771.1\ntarget frame -> peak   6026.0   5.5    3.5      0.0   1.0   2.0   5.0   8.0  10.0     12.0\ntarget frame -> start  6026.0  -8.7  218.8 -16769.0 -20.0  -8.0  -3.0   1.0   4.0   1429.0\nnow frame -> start     6026.0  27.3  218.8 -16733.0  16.0  28.0  33.0  37.0  40.0   1465.0\nnow frame -> peak      6026.0  41.5    3.5     36.0  37.0  38.0  41.0  44.0  46.0     48.0\n1st input -> peak      6026.0  65.5    3.5     60.0  61.0  62.0  65.0  68.0  70.0     72.0\n  fraction of samples where the flare had NOT yet started at the 'now' input frame: 95.5%\n  fraction where it had NOT started at the TARGET frame: 28.3%\n\n===== VAL (n=299, tolerance 12m) =====   minutes; positive = event is AFTER the frame\n                       count  mean     std      min   10%   25%   50%   75%   90%      max\nrise start->peak       299.0  82.0  1228.4      1.0   4.0   5.0   8.0  13.0  21.2  21251.0\ntarget frame -> peak   299.0   5.3     3.4      0.0   1.0   2.0   5.0   8.0  11.0     12.0\ntarget frame -> start  299.0 -76.7  1228.3 -21245.0 -16.2  -9.0  -4.0   0.0   4.0      8.0\nnow frame -> start     299.0 -40.7  1228.3 -21209.0  19.8  27.0  32.0  36.0  40.0     44.0\nnow frame -> peak      299.0  41.3     3.4     36.0  37.0  38.0  41.0  44.0  47.0     48.0\n1st input -> peak      299.0  65.3     3.4     60.0  61.0  62.0  65.0  68.0  71.0     72.0\n  fraction of samples where the flare had NOT yet started at the 'now' input frame: 98.0%\n  fraction where it had NOT started at the TARGET frame: 21.7%\nShell cwd was reset to /home/jovyan/tmp/surya_workshop/downstream_apps/flare_forecast/old-chats-notebooks"
