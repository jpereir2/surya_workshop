            "raw_output": "hek_flare_catalog.csv\n--- yaml data section ---\n# =============================================================================\n# Surya workshop \u2014 template fine-tuning config\n#\n# Five sections own all parameters:\n#   data      \u2014 what to load and how to align labels\n#   model     \u2014 backbone architecture, fine-tuning head, LoRA\n#   training  \u2014 optimization and augmentation hyperparameters\n#   output    \u2014 where to save checkpoints (and optional S3 upload)\n#   logging   \u2014 experiment tracking (WandB)\n#\n# Two things to know before editing:\n#\n#   * Paths are relative to THIS FILE's directory (~ and $ENV_VARS are expanded), so a\n#     fork works on any machine with no absolute paths to fix up. The one exception is\n#     s3_cache_dir \u2014 see its comment below.\n#   * Unrecognized keys are an ERROR, not a silent no-op. To add a task-specific key,\n#     add the field to your DataConfig subclass in configs.py first.\n#\n# Usage \u2014 --config defaults to this file, so the short form is enough:\n#   CUDA_VISIBLE_DEVICES=0,1 python -m downstream_apps.template.3_finetune_template_1D\n#\n# Per-run overrides that do not require editing this file:\n#   --max-epochs 5     --batch-size 4     --s3-cache-dir /scratch/$USER/cache\n#   --deterministic warn   (reproducible run; see training.deterministic below)\n# =============================================================================\n\njob_id: solar_flare_forecasting\n\n\n# -----------------------------------------------------------------------------\n# Data\n# -----------------------------------------------------------------------------\ndata:\n  # -- Paths (relative to this file's directory) --\n  train_data_path: ../../../data/indices/surya_aws_s3_train.csv\n  valid_data_path: ../../../data/indices/surya_aws_s3_val.csv\n  scalers_path: ../assets/scalers.yaml\n\n  # -- Input channels and temporal sampling --\n  channels: [aia94, aia131, aia171, aia193, aia211, aia304, aia335, aia1600,\n             hmi_m, hmi_bx, hmi_by, hmi_bz, hmi_v]\n  time_delta_input_minutes: [-60, -36]   # Offsets (minutes) of input frames relative to reference timestep\n  time_delta_target_minutes: 0   # Step size (minutes) between forecast frames\n\n  # -- Downstream label alignment (flare catalog \u2192 Surya index) --\n  flare_index_path: ../data/hek_flare_catalog.csv\n#  ds_time_column: start_time      # Column in the flare catalog used as the event timestamp\n  ds_time_column: peak_time      # Column in the flare catalog used as the event timestamp\n  ds_time_tolerance: 4d           # Max allowed gap between catalog and Surya timestamps\n  ds_match_direction: forward     # \"forward\": use solar state *before* the flare (causal)\n\n  # -- Local data (only needed when the index contains relative local paths) --\n  # sdo_data_root_path: /path/to/sdo   # Prepended to relative local paths; ignored for s3://\n\n  # -- S3 (only needed when index contains s3:// paths) --\n  s3_anon: true                   # true for public buckets; false to use IAM credentials\n\n  # How S3 objects are read. Measured on one 13-channel SDO sample from\n  # s3://nasa-surya-bench (times are indicative, not a benchmark):\n  #\nShell cwd was reset to /home/jovyan/tmp/surya_workshop/downstream_apps/flare_forecast/old-chats-notebooks",
