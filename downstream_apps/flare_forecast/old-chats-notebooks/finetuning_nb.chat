              "command": "cd /home/jovyan/tmp/surya_workshop && cat > /tmp/t_budget.py <<'PYEOF'\nimport sys, os, glob, re, time, shutil; sys.path.append(\".\")\nos.environ[\"CUDA_VISIBLE_DEVICES\"]=\"0\"\nimport numpy as np, pandas as pd, torch\nfrom concurrent.futures import ThreadPoolExecutor\nT0=time.time()\ndef log(m): print(f\"[{time.time()-T0:7.1f}s] {m}\", flush=True)\n\nfrom downstream_apps.flare_forecast.configs import load_flare_config\nfrom workshop_infrastructure.assets import ensure_assets\nfrom workshop_infrastructure.utils import build_scalers, load_pretrained_weights\nfrom downstream_apps.flare_forecast.datasets.flare_dataset import flare_Dataset\nfrom workshop_infrastructure.datasets.builders import build_helio_datasets\ncfg = load_flare_config(\"downstream_apps/flare_forecast/configs/config_script.yaml\")\nensure_assets(cfg); scalers = build_scalers(info=cfg.data.scalers_path)\ntr, va = build_helio_datasets(cfg, flare_Dataset, scalers=scalers,\n    return_surya_stack=True, max_number_of_samples=None, flip_probability=0.0,\n    ds_flare_index_path=cfg.data.flare_index_path, ds_time_column=cfg.data.ds_time_column,\n    ds_time_tolerance=cfg.data.ds_time_tolerance, ds_match_direction=cfg.data.ds_match_direction)\n\ncached=set()\nfor p in glob.glob(os.path.join(cfg.data.s3_cache_dir,\"*.nc\")):\n    m=re.search(r\"__(\\d{8}_\\d{4})\\.nc$\",os.path.basename(p))\n    if m: cached.add(pd.Timestamp(m.group(1).replace(\"_\",\"T\")))\noffsets=list(cfg.data.time_delta_input_minutes)+[0]\nref=pd.DatetimeIndex(tr.valid_indices)\nwarm=np.ones(len(ref),bool)\nfor o in offsets: warm &= np.array([t+pd.Timedelta(minutes=o) in cached for t in ref])\nwarm_idx=np.flatnonzero(warm); cold_idx=np.flatnonzero(~warm)\nlog(f\"{len(warm_idx)} warm / {len(cold_idx)} cold train samples\")\n\n# ---------- (A) WARM read: CPU decode + normalize, no network ----------\nts=[]\nfor i in warm_idx[:4]:\n    t=time.perf_counter(); s=tr[int(i)]; ts.append(time.perf_counter()-t); del s\nlog(f\"A. WARM read per sample: {np.mean(ts):.1f}s  (each {[f'{x:.1f}' for x in ts]})\")\n\n# ---------- (B) file size ----------\nfiles=glob.glob(os.path.join(cfg.data.s3_cache_dir,\"*.nc\"))[:20]\nmb=np.mean([os.path.getsize(f)/2**20 for f in files])\nlog(f\"B. mean cached file size {mb:.0f} MB  -> {3*mb/1024:.2f} GB per sample (3 frames)\")\n\n# ---------- (C) COLD read serial ----------\nts=[]\nfor i in cold_idx[:3]:\n    t=time.perf_counter(); s=tr[int(i)]; ts.append(time.perf_counter()-t); del s\nlog(f\"C. COLD read serial: {np.mean(ts):.1f}s/sample  (each {[f'{x:.1f}' for x in ts]})\"\n    f\"  -> download share ~{np.mean(ts)-np.mean([x for x in ts])*0:.1f}s\")\n\n# ---------- (D) COLD read with 8 threads ----------\npick=[int(i) for i in cold_idx[10:10+16]]\ndef rd(i):\n    t=time.perf_counter(); s=tr[i]; d=time.perf_counter()-t; del s; return d\nt0=time.perf_counter()\nwith ThreadPoolExecutor(max_workers=8) as ex: per=list(ex.map(rd,pick))\nwall=time.perf_counter()-t0\nlog(f\"D. COLD 16 samples / 8 threads: wall {wall:.0f}s -> {wall/len(pick):.1f}s per sample \"\n    f\"({len(pick)*3*mb/1024/wall*1000:.0f} MB/s aggregate)\")\n\n# ---------- (E) GPU training step ----------\nfrom workshop_infrastructure.models.finetune_models import HelioSpectformer2D\nfrom workshop_infrastructure.utils import apply_peft_lora\nmodel=HelioSpectformer2D.from_config(cfg.model, ft_out_chans=len(cfg.data.channels),\n    ft_unembedding_type=\"linear\", dtype=cfg.dtype,\n    use_latitude_in_learned_flow=cfg.use_latitude_in_learned_flow)\nload_pretrained_weights(model,cfg.model.pretrained_path)\n_ck=torch.load(cfg.model.pretrained_path,weights_only=True,map_location=\"cpu\"); _ms=model.state_dict()\nfor k,v in _ck.items():\n    if f\"head_{k}\" in _ms: _ms[f\"head_{k}\"]=v\nmodel.load_state_dict(_ms,strict=True); del _ck,_ms\ncfg.model.lora.target_modules=[\"fc1\",\"fc2\",\"attn.qkv\",\"attn.proj\"]\nmodel=apply_peft_lora(model,cfg.model.lora)\nmodel=model.to(\"cuda\").train()\nopt=torch.optim.Adam([p for p in model.parameters() if p.requires_grad],lr=1e-4)\nfrom torch.utils.data._utils.collate import default_collate\nwarm_samples=[tr[int(i)] for i in warm_idx[:2]]\nfor bs in (1,2):\n    if bs>len(warm_samples): break\n    try:\n        b=default_collate(warm_samples[:bs])\n        b={k:(v.to(\"cuda\") if torch.is_tensor(v) else v) for k,v in b.items()}\n        tgt=b[\"forecast\"][:,:,0].float()\n        torch.cuda.reset_peak_memory_stats(); step=[]\n        for _ in range(3):\n            t=time.perf_counter()\n            with torch.autocast(\"cuda\",dtype=torch.bfloat16):\n                loss=torch.nn.functional.mse_loss(model(b).float(),tgt)\n            loss.backward(); opt.step(); opt.zero_grad(set_to_none=True)\n            torch.cuda.synchronize(); step.append(time.perf_counter()-t)\n        log(f\"E. GPU train step bs={bs}: {min(step):.2f}s  peak {torch.cuda.max_memory_allocated()/2**30:.1f} GB \"\n            f\"of {torch.cuda.get_device_properties(0).total_memory/2**30:.0f} GB  -> {min(step)/bs:.2f}s/sample\")\n        del b,tgt,loss; torch.cuda.empty_cache()\n    except torch.cuda.OutOfMemoryError:\n        log(f\"E. GPU train step bs={bs}: OOM\"); torch.cuda.empty_cache()\nlog(\"DONE\")\nPYEOF\n/home/jovyan/envs/surya_ws/bin/python /tmp/t_budget.py > /tmp/budget.log 2>&1 &\necho \"launched\"",
