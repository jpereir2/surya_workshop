_ in lit_model.parameters(): _p_.grad = None # Per-sample error, so you can see the two orientations separately inside one batch. for _n, (_tag, _) in enumerate(SAMPLES): print(f\" {_tag:8s} error {torch.mean((_out[_n].float() - _target[_n]) ** 2).item():.4f}\") print(f\"batch loss {_loss.item():.4f} backward={BACKWARD}\") if dev == \"cuda\": print(f\"peak GPU memory {torch.cuda.max_memory_allocated()/2**30:.1f} GB of \" f\"{torch.cuda.get_device_properties(0).total_memory/2**30:.0f} GB\") del _b, _out, _loss, _target, mixed lit_model = lit_model.to(\"cpu\") if dev == \"cuda\": torch.cuda.empty_cache() print(\"\\\\nA mixed batch survives collate, the forward pass and the backward pass.\") ''' nb[\"cells\"][12] = C(MIXED) # ---------------------------------------------------------------- rewrite cell 13 src = nb[\"cells\"][13][\"source\"] assert src[23].strip() == \"item = train_dataset[idx]\", src[23] head = src[:23] # imports, CHANNELS_TO_PLOT, STRIDE, train_dataset, idx body = src[24:] # everything that depends on `item` # STRIDE 1 x 2 orientations x 2 scale versions = four full-4096 figures. Stride for a check. head = [l.replace(\"STRIDE = 1 \", \"STRIDE = 4 \") for l in head] loop = [\"\\n\", \"# One figure set per orientation. SAMPLES comes from the cell above, where each item\\n\", \"# was produced by the dataset's own flip -- same flare, both ways.\\n\", \"for ORIENT, item in SAMPLES:\\n\", ' print(\"\\\\n\" + \"=\" * 100 + f\"\\\\n{ORIENT}\\\\n\" + \"=\" * 100)\\n'] indented = [\" \" + l if l.strip() else l for l in body] # Name the orientation on the figure itself so two saved figures are never confused. for n, l in enumerate(indented): if 'f\"[{tag} scaling' in l: indented[n] = l.replace('f\"[{tag} scaling', 'f\"{ORIENT} [{tag} scaling') break else: raise AssertionError(\"suptitle line not found\") nb[\"cells\"][13][\"source\"] = head + loop + indented json.dump(nb, open(NB, \"w\"), indent=1) import nbformat, warnings, ast warnings.simplefilter(\"error\") _nb = nbformat.read(NB, as_version=4) nbformat.validate(_nb) for c in _nb.cells: if c[\"cell_type\"] == \"code\": ast.parse(\"\".join(c[\"source\"])) print(f\"{NB}: {len(_nb.cells)} cells, valid, every code cell parses\") print(\"cell 13 stride line:\", [l.strip() for l in _nb.cells[13][\"source\"] if \"STRIDE \" in l]) print(\"cell 13 loop :\", [l.rstrip() for l in _nb.cells[13][\"source\"] if l.startswith(\"for ORIENT\")]) PYEOF",
