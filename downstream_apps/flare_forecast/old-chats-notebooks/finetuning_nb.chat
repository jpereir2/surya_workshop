            "tool_call_id": "toolu_bdrk_016JZqDpSqd7g4aEBNcmbpdy",
            "title": "cd surya_workshop && cat > t_bar2.py <<'PYEOF' import sys; sys.path.append(\".\") import matplotlib; matplotlib.use(\"Agg\") from downstream_apps.flare_forecast.configs import load_flare_config from workshop_infrastructure.assets import ensure_assets from workshop_infrastructure.utils import build_scalers from downstream_apps.flare_forecast.datasets.flare_dataset import flare_Dataset cfg = load_flare_config(\"downstream_apps/flare_forecast/configs/config_script.yaml\") ensure_assets(cfg); scalers = build_scalers(info=cfg.data.scalers_path) # ===================== CELL TO PASTE STARTS HERE ===================== # Flares per year and per GOES class (C / M / X) in the train and val splits, # uncapped by N_SAMPLES. Index matching only -- no NetCDF is read. import numpy as np, pandas as pd, matplotlib.pyplot as plt from workshop_infrastructure.datasets.builders import build_helio_datasets _splits = build_helio_datasets( cfg, flare_Dataset, scalers=scalers, return_surya_stack=True, max_number_of_samples=None, flip_probability=0.0, ds_flare_index_path=cfg.data.flare_index_path, ds_time_column=cfg.data.ds_time_column, ds_time_tolerance=cfg.data.ds_time_tolerance, ds_match_direction=cfg.data.ds_match_direction, ) CLASSES = [\"C\", \"M\", \"X\"] COLOR = {\"C\": \"#9fb8d4\", \"M\": \"#e08a3c\", \"X\": \"#a5243d\"} tables = {} for _name, _d in zip((\"train\", \"val\"), _splits): _df = _d.df_valid_indices.copy() _df[\"year\"] = pd.DatetimeIndex(_d.valid_indices).year # CMX is the catalog's own class letter; cross-check it against GOES_class. _letter = _df[\"GOES_class\"].astype(str).str[0] assert (_df[\"CMX\"].astype(str).str.upper() == _letter).all(), \"CMX disagrees with GOES_class\" _df[\"cls\"] = pd.Categorical(_letter, categories=CLASSES) assert _df[\"cls\"].notna().all(), f\"unexpected classes: {sorted(set(_letter) - set(CLASSES))}\" tables[_name] = _df.pivot_table(index=\"year\", columns=\"cls\", aggfunc=\"size\", observed=False, fill_value=0)[CLASSES] del _splits # Every year in the range, so missing ones (2012, 2022) show as visible gaps. years = np.arange(min(t.index.min() for t in tables.values()), max(t.index.max() for t in tables.values()) + 1) tables = {k: v.reindex(years, fill_value=0) for k, v in tables.items()} fig, axes = plt.subplots(2, 1, figsize=(12, 7.5), sharex=True, gridspec_kw={\"height_ratios\": [2, 1], \"hspace\": 0.28}) for ax, name, window in ((axes[0], \"train\", \"Mar-Dec\"), (axes[1], \"val\", \"Jan 16-30 only\")): t = tables[name] bottom = np.zeros(len(years)) for c in CLASSES: ax.bar(years, t[c].values, bottom=bottom, color=COLOR[c], width=0.72, label=f\"{c} (n={t[c].sum():,})\", edgecolor=\"white\", linewidth=0.4) bottom += t[c].values for x, tot, mx in zip(years, t.sum(1).values, (t[\"M\"] + t[\"X\"]).values): if tot == 0: ax.annotate(\"0\", (x, 0), textcoords=\"offset points\", xytext=(0, 3), ha=\"center\", fontsize=8, color=\"#999999\") else: ax.annotate(f\"{tot:,}\\nM+X {mx}\", (x, tot), textcoords=\"offset points\", xytext=(0, 3), ha=\"center\", fontsize=7.5, linespacing=1.25) ax.set_ylabel(\"flares\") ax.set_title(f\"{name.upper()} ({t.values.sum():,} flares, {window})\", loc=\"left\", fontsize=11, fontweight=\"bold\") ax.set_ylim(0, max(t.sum(1).max() * 1.30, 1)) ax.grid(axis=\"y\", alpha=0.3) ax.spines[[\"top\", \"right\"]].set_visible(False) ax.legend(frameon=False, fontsize=9, loc=\"upper right\", title=\"GOES class\", title_fontsize=9) axes[1].set_xticks(years) axes[1].set_xticklabels(years, rotation=45, ha=\"right\") axes[1].set_xlabel(\"year\") fig.suptitle(\"Flares per year and GOES class, Surya train/val split \" f\"(matched on {cfg.data.ds_time_column}, tolerance {cfg.data.ds_time_tolerance})\", fontsize=12, y=0.965) plt.show() for name, t in tables.items(): out = t.T out[\"TOTAL\"] = out.sum(1) print(f\"\\n{name.upper()}\") print(out.to_string()) # ====================== CELL TO PASTE ENDS HERE ====================== plt.savefig(\"/tmp/flares_cmx.png\", dpi=110, bbox_inches=\"tight\") PYEOF python t_bar2.py 2>&1 | grep -v \"FutureWarning\\|warnings.warn\""
          },
