ully cached ({100*have.mean():.1f}%)\")\n    t = df[df.warm].pivot_table(index=\"year\", columns=\"cls\", aggfunc=\"size\", fill_value=0)\n    if len(t): \n        t[\"TOTAL\"] = t.sum(1); print(t.to_string())\n    else:\n        print(\"  none\")\nPYEOF\n/home/jovyan/envs/surya_ws/bin/python /tmp/t_cache.py 2>&1 | grep -v \"FutureWarning\\|warnings.warn\""
