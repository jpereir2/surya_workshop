            "raw_input": {
              "command": "cd /home/jovyan/tmp/surya_workshop && /home/jovyan/envs/surya_ws/bin/python - <<'EOF'\nimport hashlib, os, re\nfrom workshop_infrastructure.utils import parse_s3_uri\n\ndef cache_path(s3_uri, cache_dir):\n    bucket, key = parse_s3_uri(s3_uri)\n    base = os.path.basename(key) or \"object\"\n    base_safe = re.sub(r\"[^A-Za-z0-9._-]+\", \"_\", base).strip(\"._-\") or \"object\"\n    _, ext = os.path.splitext(base_safe)\n    suffix = ext if ext else \".nc\"\n    h = hashlib.sha1(f\"{bucket}/{key}\".encode()).hexdigest()\n    fname = f\"{bucket}__{h}__{base_safe}\"\n    if not fname.endswith(suffix): fname += suffix\n    return os.path.join(cache_dir, fname)\n\ncd = \"/home/jovyan/scratch_space/surya_cache\"\n# take a few real cached files, reconstruct the s3 uri from the date in the name, verify hash\nimport pandas as pd\nd = pd.read_csv(\"data/indices/surya_aws_s3_train.csv\", nrows=5000)\nhits = miss = 0\nfor uri in d[\"path\"].head(200):\n    p = cache_path(uri, cd)\n    if os.path.exists(p): hits += 1\n    else: miss += 1\nprint(f\"of first 200 train URIs: {hits} found in cache via reconstructed path, {miss} absent\")\nprint(\"example reconstructed:\", os.path.basename(cache_path(d['path'].iloc[0], cd)))\nexisting = sorted(os.listdir(cd))[:2]\nprint(\"example actually on disk:\", existing)\nEOF"
