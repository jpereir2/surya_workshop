              "command": "cd /home/jovyan/tmp/surya_workshop/downstream_apps/flare_forecast && /home/jovyan/envs/surya_ws/bin/python - <<'PYEOF'\nimport json, uuid\nNB = \"2b_flip_minimal.ipynb\"\nnb = json.load(open(NB))\n\ndef C(t):\n    return {\"cell_type\": \"code\", \"execution_count\": None, \"metadata\": {}, \"outputs\": [],\n            \"id\": uuid.uuid4().hex[:8], \"source\": t.strip(\"\\n\").splitlines(keepends=True)}\n\n# ---------------------------------------------------------------- new cell 12\nMIXED = '''\n# Can one batch hold both orientations at once? That is what a flip_probability of 0.5\n# actually produces, so it is what training and validation have to survive.\n#\n# Both samples are the SAME flare, read twice from the dataset with its own flip forced on\n# and off -- so this exercises the real pipeline, not arrays we flipped by hand.\nfrom torch.utils.data._utils.collate import default_collate\n\nBACKWARD = True          # set False if a batch of 2 will not fit on your card\n\n_ds = train_data_loader.dataset\n_saved_p, _idx = _ds.flip_probability, 0\n_items = []\nfor _p in (0.0, 1.0):\n    _ds.flip_probability = _p\n    _items.append(_ds[_idx])\n_ds.flip_probability = _saved_p\n\nassert not _items[0][\"was_flipped\"] and _items[1][\"was_flipped\"], \"dataset flip did not follow p\"\nSAMPLES = [(\"UPRIGHT\", _items[0]), (\"FLIPPED\", _items[1])]   # cell 13 plots both of these\n\ndev = \"cuda\" if torch.cuda.is_available() else \"cpu\"\nmixed = default_collate(_items)\nprint(f\"mixed batch was_flipped = {[bool(f) for f in mixed['was_flipped']]}  \"\n      f\"ts {tuple(mixed['ts'].shape)}\")\nassert len(set(bool(f) for f in mixed[\"was_flipped\"])) == 2, \"batch is not mixed\"\n\nlit_model = lit_model.to(dev)\nlit_model.train() if BACKWARD else lit_model.eval()\nif dev == \"cuda\":\n    torch.cuda.reset_peak_memory_stats()\n_b = {k: (v.to(dev) if torch.is_tensor(v) else v) for k, v in mixed.items()}\n_target = _b[\"forecast\"][:, :, 0].float()\n\nwith torch.autocast(device_type=dev, dtype=torch.bfloat16):\n    _out = lit_model(_b)\n    _loss = torch.nn.functional.mse_loss(_out.float(), _target)\nif BACKWARD:\n    _loss.backward()\n    for _p_ in lit_model.parameters():\n        _p_.grad = None\n\n# Per-sample error, so you can see the two orientations separately inside one batch.\nfor _n, (_tag, _) in enumerate(SAMPLES):\n    print(f\"  {_tag:8s} error {torch.mean((_out[_n].float() - _target[_n]) ** 2).item():.4f}\")\nprint(f\"batch loss {_loss.item():.4f}   backward={BACKWARD}\")\nif dev == \"cuda\":\n    print(f\"peak GPU memory {torch.cuda.max_memory_allocated()/2**30:.1f} GB of \"\n          f\"{torch.cuda.get_device_properties(0).total_memory/2**30:.0f} GB\")\n\ndel _b, _out, _loss, _target, mixed\nlit_model = lit_model.to(\"cpu\")\nif dev == \"cuda\":\n    torch.cuda.empty_cache()\nprint(\"\\\\nA mixed batch survives collate, the forward pass and the backward pass.\")\n'''\nnb[\"cells\"][12] = C(MIXED)\n\n# ---------------------------------------------------------------- rewrite cell 13\nsrc = nb[\"cells\"][13][\"source\"]\nassert src[23].strip() == \"item = train_dataset[idx]\", src[23]\n\nhead = src[:23]                     # imports, CHANNELS_TO_PLOT, STRIDE, train_dataset, idx\nbody = src[24:]                     # everything that depends on `item`\n\n# STRIDE 1 x 2 orientations x 2 scale versions = four full-4096 figures. Stride for a check.\nhead = [l.replace(\"STRIDE           = 1  \", \"STRIDE           = 4  \") for l in head]\n\nloop = [\"\\n\",\n        \"# One figure set per orientation. SAMPLES comes from the cell above, where each item\\n\",\n        \"# was produced by the dataset's own flip -- same flare, both ways.\\n\",\n        \"for ORIENT, item in SAMPLES:\\n\",\n        '    print(\"\\\\n\" + \"=\" * 100 + f\"\\\\n{ORIENT}\\\\n\" + \"=\" * 100)\\n']\nindented = [\"    \" + l if l.strip() else l for l in body]\n\n# Name the orientation on the figure itself so two saved figures are never confused.\nfor n, l in enumerate(indented):\n    if 'f\"[{tag} scaling' in l:\n        indented[n] = l.replace('f\"[{tag} scaling', 'f\"{ORIENT}   [{tag} scaling')\n        break\nelse:\n    raise AssertionError(\"suptitle line not found\")\n\nnb[\"cells\"][13][\"source\"] = head + loop + indented\n\njson.dump(nb, open(NB, \"w\"), indent=1)\n\nimport nbformat, warnings, ast\nwarnings.simplefilter(\"error\")\n_nb = nbformat.read(NB, as_version=4)\nnbformat.validate(_nb)\nfor c in _nb.cells:\n    if c[\"cell_type\"] == \"code\":\n        ast.parse(\"\".join(c[\"source\"]))\nprint(f\"{NB}: {len(_nb.cells)} cells, valid, every code cell parses\")\nprint(\"cell 13 stride line:\", [l.strip() for l in _nb.cells[13][\"source\"] if \"STRIDE  \" in l])\nprint(\"cell 13 loop      :\", [l.rstrip() for l in _nb.cells[13][\"source\"] if l.startswith(\"for ORIENT\")])\nPYEOF"
            },
