      "id": "c4e4bff3-7e6b-459b-bf03-6dc56e23827c",
      "raw_time": false,
      "time": 1789655092.1672199,
      "type": "msg",
      "body": "Now I've got it. Three changes: plots move after `fit`, the two plotted samples come from the *natural* random flip rather than a forced copy, and a data-size cell at the end.",
      "sender": "jupyter-ai-personas::jupyter_ai_acp_client::ClaudeAcpPersona"
    },
    {
      "time": 1789655116.5649579,
      "sender": "jupyter-ai-personas::jupyter_ai_acp_client::ClaudeAcpPersona",
      "metadata": {
        "tool_calls": [
          {
            "title": "cd flare_forecast && python - <<'PYEOF' import json, uuid NB = \"2b_flip_minimal.ipynb\" nb = json.load(open(NB)) old = nb[\"cells\"] def C(t): return {\"cell_type\": \"code\", \"execution_count\": None, \"metadata\": {}, \"outputs\": [], \"id\": uuid.uuid4().hex[:8], \"source\": t.strip(\"\\n\").splitlines(keepends=True)} # ---- 1. bump N_SAMPLES so both orientations are likely to occur naturally ------------- s4 = old[4][\"source\"] i = next(n for n, l in enumerate(s4) if l.startswith(\"N_SAMPLES\")) s4[i] = (\"N_SAMPLES = 6 # per split. At p=0.5, 6 samples give a ~97% chance of\\n\" \" # containing both orientations by chance. Min 2.\\n\") # ---- 2. the scan cell: find one naturally-flipped and one naturally-unflipped --------- SCAN = ''' # Walk the training set with the real random flip left alone and keep the FIRST sample of # each orientation that actually turns up. Nothing is forced and nothing is copied: these # are two different flares that happened to land on opposite sides of the coin. If both # turn up, the 50/50 mixing is working. ds = train_data_loader.dataset print(f\"scanning {len(ds)} samples at flip_probability={ds.flip_probability}\") found = {} pattern = [] for i in range(len(ds)): s = ds[i] was = bool(s[\"was_flipped\"]) pattern.append(\"F\" if was else \".\") if was not in found: found[was] = (i, s) else: del s print(f\"\\\\r {i+1}/{len(ds)} {''.join(pattern)}\", end=\"\", flush=True) if len(found) == 2: break print(f\"\\\\n F = flipped, . = upright -> {''.join(pattern)}\") assert len(found) == 2, ( f\"only got {'flipped' if True in found else 'upright'} samples in {len(pattern)} draws. \" \"Re-run this cell, or raise N_SAMPLES in cell 4, or check FLIP_PROBABILITY is 0.5.\" ) # (tag, dataset index, sample) -- the index matters, the two samples are different flares. SAMPLES = [(\"NOT FLIPPED\", *found[False]), (\"FLIPPED\", *found[True])] SAMPLES = [(tag, idx, item) for tag, idx, item in SAMPLES] for tag, idx, item in SAMPLES: print(f\" {tag:12s} dataset index {idx} event {item['ds_index']}\") ''' # ---- 3. the plot cell: per-sample index, so the provenance report matches each flare --- s13 = old[13][\"source\"] k = next(n for n, l in enumerate(s13) if l.startswith(\"idx \")) del s13[k] # idx now comes from SAMPLES j = next(n for n, l in enumerate(s13) if l.startswith(\"for ORIENT\")) s13[j] = \"for ORIENT, idx, item in SAMPLES:\\n\" s13[j - 2:j] = [ \"# One figure set per orientation, from the two real samples the scan cell found.\\n\", \"# idx travels with each sample so the timestamps and GOES class below are its own.\\n\", ] # ---- 4. how big is the data, uncapped (index matching only, no image reads) ------------ SIZES = ''' # How much data is actually available, ignoring the N_SAMPLES cap. This only does index # matching -- no NetCDF is read -- so it is fast. from workshop_infrastructure.datasets.builders import build_helio_datasets _full = build_helio_datasets( cfg, flare_Dataset, scalers=scalers, return_surya_stack=True, max_number_of_samples=None, # <- no cap flip_probability=0.0, ds_flare_index_path=cfg.data.flare_index_path, ds_time_column=cfg.data.ds_time_column, ds_time_tolerance=cfg.data.ds_time_tolerance, ds_match_direction=cfg.data.ds_match_direction, ) for _name, _d in zip((\"train\", \"val\"), _full): _t = pd.DatetimeIndex(_d.valid_indices) print(f\"{_name:5s}: {len(_d):5d} samples {_t.min().date()} -> {_t.max().date()}\") print(f\" by year: {dict(sorted(_t.year.value_counts().items()))}\") print(f\"\\\\nsteps per epoch at batch_size={cfg.batch_size}, drop_last=True:\") for _name, _d in zip((\"train\", \"val\"), _full): print(f\" {_name:5s}: {len(_d)  cfg.batch_size} steps for the full set | \" f\"{N_SAMPLES  cfg.batch_size} steps at your current N_SAMPLES={N_SAMPLES}\") del _full ''' # ---- reassemble: plots and the scan move after fit ------------------------------------ nb[\"cells\"] = [ old[0], # 0 markdown header *old[1:12], # 1-11 setup .. flip check (old 12 forced-mix dropped) old[14], # 12 loggers + trainer old[15], # 13 fit C(SCAN), # 14 find one of each orientation old[13], # 15 plot both C(SIZES), # 16 how big is the data *old[16:], # markdown + spare cell ] json.dump(nb, open(NB, \"w\"), indent=1) import nbformat, warnings, ast warnings.simplefilter(\"error\") _nb = nbformat.read(NB, as_version=4) nbformat.validate(_nb) for c in _nb.cells: if c[\"cell_type\"] == \"code\": ast.parse(\"\".join(c[\"source\"])) print(f\"{NB}: {len(_nb.cells)} cells, valid, all parse\\n\") for n, c in enumerate(_nb.cells): s = \"\".join(c[\"source\"]).strip().split(\"\\n\") print(f\"{n:3d} {c['cell_type'][:4]:4s} {len(s):4d}ln | {(s[0] if s else '(empty)')[:60]}\") PYEOF",
            "tool_call_id": "toolu_bdrk_01F3x9m7M16D77YYF22TkV8P",
            "status": "completed",
            "kind": "execute",
            "raw_input": {
              "command": "cd /home/jovyan/tmp/surya_workshop/downstream_apps/flare_forecast && /home/jovyan/envs/surya_ws/bin/python - <<'PYEOF'\nimport json, uuid\nNB = \"2b_flip_minimal.ipynb\"\nnb = json.load(open(NB))\nold = nb[\"cells\"]\n\ndef C(t):\n    return {\"cell_type\": \"code\", \"execution_count\": None, \"metadata\": {}, \"outputs\": [],\n            \"id\": uuid.uuid4().hex[:8], \"source\": t.strip(\"\\n\").splitlines(keepends=True)}\n\n# ---- 1. bump N_SAMPLES so both orientations are likely to occur naturally -------------\ns4 = old[4][\"source\"]\ni = next(n for n, l in enumerate(s4) if l.startswith(\"N_SAMPLES\"))\ns4[i] = (\"N_SAMPLES        = 6      # per split. At p=0.5, 6 samples give a ~97% chance of\\n\"\n         \"                          # containing both orientations by chance. Min 2.\\n\")\n\n# ---- 2. the scan cell: find one naturally-flipped and one naturally-unflipped ---------\nSCAN = '''\n# Walk the training set with the real random flip left alone and keep the FIRST sample of\n# each orientation that actually turns up. Nothing is forced and nothing is copied: these\n# are two different flares that happened to land on opposite sides of the coin. If both\n# turn up, the 50/50 mixing is working.\nds = train_data_loader.dataset\nprint(f\"scanning {len(ds)} samples at flip_probability={ds.flip_probability}\")\n\nfound = {}\npattern = []\nfor i in range(len(ds)):\n    s = ds[i]\n    was = bool(s[\"was_flipped\"])\n    pattern.append(\"F\" if was else \".\")\n    if was not in found:\n        found[was] = (i, s)\n    else:\n        del s\n    print(f\"\\\\r  {i+1}/{len(ds)}  {''.join(pattern)}\", end=\"\", flush=True)\n    if len(found) == 2:\n        break\nprint(f\"\\\\n  F = flipped, . = upright  ->  {''.join(pattern)}\")\n\nassert len(found) == 2, (\n    f\"only got {'flipped' if True in found else 'upright'} samples in {len(pattern)} draws. \"\n    \"Re-run this cell, or raise N_SAMPLES in cell 4, or check FLIP_PROBABILITY is 0.5.\"\n)\n\n# (tag, dataset index, sample) -- the index matters, the two samples are different flares.\nSAMPLES = [(\"NOT FLIPPED\", *found[False]), (\"FLIPPED\", *found[True])]\nSAMPLES = [(tag, idx, item) for tag, idx, item in SAMPLES]\nfor tag, idx, item in SAMPLES:\n    print(f\"  {tag:12s} dataset index {idx}   event {item['ds_index']}\")\n'''\n\n# ---- 3. the plot cell: per-sample index, so the provenance report matches each flare ---\ns13 = old[13][\"source\"]\nk = next(n for n, l in enumerate(s13) if l.startswith(\"idx  \"))\ndel s13[k]                                    # idx now comes from SAMPLES\nj = next(n for n, l in enumerate(s13) if l.startswith(\"for ORIENT\"))\ns13[j] = \"for ORIENT, idx, item in SAMPLES:\\n\"\ns13[j - 2:j] = [\n    \"# One figure set per orientation, from the two real samples the scan cell found.\\n\",\n    \"# idx travels with each sample so the timestamps and GOES class below are its own.\\n\",\n]\n\n# ---- 4. how big is the data, uncapped (index matching only, no image reads) ------------\nSIZES = '''\n# How much data is actually available, ignoring the N_SAMPLES cap. This only does index\n# matching -- no NetCDF is read -- so it is fast.\nfrom workshop_infrastructure.datasets.builders import build_helio_datasets\n\n_full = build_helio_datasets(\n    cfg, flare_Dataset, scalers=scalers,\n    return_surya_stack=True,\n    max_number_of_samples=None,          # <- no cap\n    flip_probability=0.0,\n    ds_flare_index_path=cfg.data.flare_index_path,\n    ds_time_column=cfg.data.ds_time_column,\n    ds_time_tolerance=cfg.data.ds_time_tolerance,\n    ds_match_direction=cfg.data.ds_match_direction,\n)\nfor _name, _d in zip((\"train\", \"val\"), _full):\n    _t = pd.DatetimeIndex(_d.valid_indices)\n    print(f\"{_name:5s}: {len(_d):5d} samples   {_t.min().date()} -> {_t.max().date()}\")\n    print(f\"         by year: {dict(sorted(_t.year.value_counts().items()))}\")\n\nprint(f\"\\\\nsteps per epoch at batch_size={cfg.batch_size}, drop_last=True:\")\nfor _name, _d in zip((\"train\", \"val\"), _full):\n    print(f\"  {_name:5s}: {len(_d) // cfg.batch_size} steps for the full set  |  \"\n          f\"{N_SAMPLES // cfg.batch_size} steps at your current N_SAMPLES={N_SAMPLES}\")\ndel _full\n'''\n\n# ---- reassemble: plots and the scan move after fit ------------------------------------\nnb[\"cells\"] = [\n    old[0],                       # 0  markdown header\n    *old[1:12],                   # 1-11 setup .. flip check   (old 12 forced-mix dropped)\n    old[14],                      # 12 loggers + trainer\n    old[15],                      # 13 fit\n    C(SCAN),                      # 14 find one of each orientation\n    old[13],                      # 15 plot both\n    C(SIZES),                     # 16 how big is the data\n    *old[16:],                    # markdown + spare cell\n]\n\njson.dump(nb, open(NB, \"w\"), indent=1)\n\nimport nbformat, warnings, ast\nwarnings.simplefilter(\"error\")\n_nb = nbformat.read(NB, as_version=4)\nnbformat.validate(_nb)\nfor c in _nb.cells:\n    if c[\"cell_type\"] == \"code\":\n        ast.parse(\"\".join(c[\"source\"]))\nprint(f\"{NB}: {len(_nb.cells)} cells, valid, all parse\\n\")\nfor n, c in enumerate(_nb.cells):\n    s = \"\".join(c[\"source\"]).strip().split(\"\\n\")\n    print(f\"{n:3d} {c['cell_type'][:4]:4s} {len(s):4d}ln | {(s[0] if s else '(empty)')[:60]}\")\nPYEOF"
            },
            "raw_output": "2b_flip_minimal.ipynb: 19 cells, valid, all parse\n\n  0 mark    6ln | # Surya 2D image forecast \u2014 flip experiment \n  1 code   17ln | import os\n  2 code    5ln | from downstream_apps.flare_forecast.configs import load_flar\n  3 code    5ln | from workshop_infrastructure.assets import ensure_assets\n  4 code   22ln | # ---- the two knobs ---------------------------------------\n  5 code   10ln | from workshop_infrastructure.models.finetune_models import H\n  6 code   20ln | load_pretrained_weights(model, cfg.model.pretrained_path)\n  7 code   18ln | # Three fine-tuning regimes, all selected from the model: se\n  8 code    9ln | from downstream_apps.flare_forecast.metrics.flare_metrics im\n  9 code   36ln | from downstream_apps.flare_forecast.lightning_modules.pl_fla\n 10 code   11ln | L.seed_everything(42, workers=True)\n 11 code   59ln | # Flip check. A: the dataset's flip is correct. B: same samp\n 12 code   34ln | project_name = cfg.wandb_project\n 13 code    5ln | # Put the mix back before training, or every epoch sees one \n 14 code   32ln | # Walk the training set with the real random flip left alone\n 15 code  239ln | import numpy as np\n 16 code   24ln | # How much data is actually available, ignoring the N_SAMPLE\n 17 mark    1ln | ## Extra checks will go below here:\n 18 code    1ln |\nShell cwd was reset to /home/jovyan/tmp/surya_workshop/downstream_apps/flare_forecast/old-chats-notebooks"
