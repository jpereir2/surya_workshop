            "raw_output": "380\t    return model\n381\t\n382\t\n383\tdef load_pretrained_weights(model: torch.nn.Module, pretrained_path: Optional[str]) -> None:\n384\t    \"\"\"Load pretrained weights into a fine-tuning model, skipping shape-mismatched keys.\n385\t\n386\t    The pretrained checkpoint was saved from HelioSpectFormer directly, so its keys\n387\t    are flat (e.g. ``embedding.proj.weight``).  The composed fine-tuning models\n388\t    (HelioSpectformer1D, HelioSpectformer2D) nest the backbone under ``backbone.*``,\n389\t    so we try both the original key and the ``backbone.``-prefixed key when matching\n390\t    against the current model's state dict.\n391\t\n392\t    Args:\n393\t        model: The fine-tuning model to load weights into.\n394\t        pretrained_path: Path to the pretrained checkpoint (.pt file). No-op if None.\n395\t    \"\"\"\n396\t    if not pretrained_path:\n397\t        return\n398\t    print(f\"Loading pretrained weights from {pretrained_path}.\")\n399\t    model_state = model.state_dict()\n400\t    checkpoint_state = torch.load(pretrained_path, weights_only=True, map_location=\"cpu\")\n401\t\n402\t    remapped = {}\n403\t    for k, v in checkpoint_state.items():\n404\t        for candidate in (k, f\"backbone.{k}\"):\n405\t            if candidate in model_state and hasattr(v, \"shape\") and v.shape == model_state[candidate].shape:\n406\t                remapped[candidate] = v\n407\t                break\n408\t\n409\t    model_state.update(remapped)\n410\t    model.load_state_dict(model_state, strict=True)\n411\t    print(f\"Loaded {len(remapped)} / {len(checkpoint_state)} pretrained weights.\")\n412\t\n413\t\n414\tclass UploadBestCheckpointToS3(L.Callback):"
