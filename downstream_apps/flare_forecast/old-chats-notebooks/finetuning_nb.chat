            "title": "cd flare_forecast && python - <<'EOF' import torch sd=torch.load(\"assets/surya.366m.v1.pt\", map_location=\"cpu\", weights_only=True) for k,v in sd.items(): if k.startswith(\"embedding\") or k.startswith(\"unembed\"): print(k, tuple(v.shape)) EOF",
            "raw_input": {
              "command": "cd /home/jovyan/tmp/surya_workshop/downstream_apps/flare_forecast && python - <<'EOF'\nimport torch\nsd=torch.load(\"assets/surya.366m.v1.pt\", map_location=\"cpu\", weights_only=True)\nfor k,v in sd.items():\n    if k.startswith(\"embedding\") or k.startswith(\"unembed\"):\n        print(k, tuple(v.shape))\nEOF",
              "description": "Inspect embedding+unembed checkpoint shapes"
