              "command": "cd /home/jovyan/tmp/surya_workshop && cat > /tmp/t_channels.py <<'PYEOF'\nimport sys, time; sys.path.append(\".\")\nimport os; os.environ[\"CUDA_VISIBLE_DEVICES\"]=\"0\"\nT0=time.time()\ndef log(m): print(f\"[{time.time()-T0:6.1f}s] {m}\", flush=True)\nimport numpy as np, pandas as pd, torch\nfrom downstream_apps.flare_forecast.configs import load_flare_config\nfrom workshop_infrastructure.assets import ensure_assets\nfrom workshop_infrastructure.utils import build_scalers, load_pretrained_weights\ncfg = load_flare_config(\"downstream_apps/flare_forecast/configs/config_script.yaml\")\nensure_assets(cfg); scalers = build_scalers(info=cfg.data.scalers_path)\nfrom downstream_apps.flare_forecast.datasets.flare_dataset import flare_Dataset\nfrom workshop_infrastructure.datasets.builders import build_helio_dataloaders\ntr, va = build_helio_dataloaders(cfg, flare_Dataset, scalers=scalers, num_workers=0,\n    return_surya_stack=True, max_number_of_samples=2, flip_probability=0.0,\n    ds_flare_index_path=cfg.data.flare_index_path, ds_time_column=cfg.data.ds_time_column,\n    ds_time_tolerance=cfg.data.ds_time_tolerance, ds_match_direction=cfg.data.ds_match_direction)\nds = tr.dataset\nprint(f\"masking knobs -> num_mask_aia_channels={ds.num_mask_aia_channels}  \"\n      f\"drop_hmi_probability={ds.drop_hmi_probability}  random_vert_flip={ds.random_vert_flip}\")\ns = ds[0]; log(f\"sample read; ts {s['ts'].shape}  forecast {s['forecast'].shape}\")\n\nfrom workshop_infrastructure.models.finetune_models import HelioSpectformer2D\nmodel = HelioSpectformer2D.from_config(cfg.model, ft_out_chans=len(cfg.data.channels),\n    ft_unembedding_type=\"linear\", dtype=cfg.dtype,\n    use_latitude_in_learned_flow=cfg.use_latitude_in_learned_flow)\nload_pretrained_weights(model, cfg.model.pretrained_path)\n_ck = torch.load(cfg.model.pretrained_path, weights_only=True, map_location=\"cpu\")\n_ms = model.state_dict()\nfor k,v in _ck.items():\n    if f\"head_{k}\" in _ms: _ms[f\"head_{k}\"] = v\nmodel.load_state_dict(_ms, strict=True); del _ck,_ms\nmodel = model.to(\"cuda\").eval()\n\nfrom torch.utils.data._utils.collate import default_collate\nb = default_collate([s])\nb = {k:(v.to(\"cuda\") if torch.is_tensor(v) else v) for k,v in b.items()}\nwith torch.no_grad(), torch.autocast(\"cuda\", dtype=torch.bfloat16):\n    pred = model(b).float()\ntgt = b[\"forecast\"][:,:,0].float()\nnow = b[\"ts\"][:,:,-1].float()\nlog(f\"pred {tuple(pred.shape)}  target {tuple(tgt.shape)}\")\n\nrows=[]\nfor i,c in enumerate(cfg.data.channels):\n    inp = b[\"ts\"][0,i].float()\n    rows.append(dict(channel=c,\n        input_std=float(inp.std()), input_allzero=bool(torch.all(inp==0)),\n        target_std=float(tgt[0,i].std()),\n        mse=float(((pred[0,i]-tgt[0,i])**2).mean()),\n        persistence=float(((now[0,i]-tgt[0,i])**2).mean())))\ndf = pd.DataFrame(rows)\ndf[\"share_of_loss_%\"] = 100*df[\"mse\"]/df[\"mse\"].sum()\npd.set_option(\"display.width\",200)\nprint(df.to_string(index=False, float_format=lambda x: f\"{x:.4f}\"))\nprint(f\"\\noverall MSE (all 13 flattened together) = {float(((pred-tgt)**2).mean()):.4f}\"\n      f\"   mean of per-channel = {df['mse'].mean():.4f}   (equal -> every channel weighted alike)\")\nlog(\"DONE\")\nPYEOF\n/home/jovyan/envs/surya_ws/bin/python /tmp/t_channels.py 2>&1 | grep -v \"FutureWarning\\|warnings.warn\""
