            "title": "cd surya_workshop && python - <<'PY' import json p = 'downstream_apps/flare_forecast/2_finetune_2D-image-flip.ipynb' nb = json.load(open(p)) src = nb['cells'][11]['source'] old = \" max_number_of_samples=3,\\n\" i = src.index(old) src[i:i+1] = [ \" max_number_of_samples=3,\\n\", \" # Fraction of samples returned with ts AND forecast flipped north-south, i.e.\\n\", \" # the opposite-polarity version of the same solar cycle. 0.0 = all upright\\n\", \" # (the default, and what every run so far has used), 0.5 = mixed, 1.0 = all flipped.\\n\", \" flip_probability=0.5,\\n\", ] json.dump(nb, open(p, 'w'), indent=1) print(''.join(nb['cells'][11]['source'][9:26])) PY"
