            "title": "cd surya_workshop && python - <<'PYEOF' import re p=\"/tmp/t_bar2.py\"; s=open(p).read() s = s.replace( 'for ax, name, window in ((axes[0], \"train\", \"Mar-Dec\"), (axes[1], \"val\", \"Jan 16-30 only\")):', 'for ax, name, window, legend_loc in ((axes[0], \"train\", \"Mar-Dec\", \"upper right\"),\\n' ' (axes[1], \"val\", \"Jan 16-30 only\", \"upper left\")):') s = s.replace('ax.legend(frameon=False, fontsize=9, loc=\"upper right\", title=\"GOES class\",', 'ax.legend(frameon=False, fontsize=9, loc=legend_loc, title=\"GOES class\",') open(p,\"w\").write(s) PYEOF python t_bar2.py 2>&1 | grep -v \"FutureWarning\\|warnings.warn\" | tail -3",
