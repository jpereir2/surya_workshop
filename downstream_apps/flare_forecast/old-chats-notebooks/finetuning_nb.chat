            ],
            "raw_output": "826\t            \"Each full-resolution SDO NetCDF file is ~1 GB, so pick a filesystem with \"\n827\t            \"roughly 1 GB x (number of unique timesteps) free.\\n\"\n828\t            \"Alternatively set s3_mode: stream to read without a local cache \"\n829\t            \"(not recommended for NetCDF/HDF5 \u2014 it requires random seeks).\"\n830\t        )\n831\t\n832\t    def _get_s3fs(self):\n833\t        \"\"\"Lazily create and cache an ``s3fs.S3FileSystem`` instance (per process).\"\"\"\n834\t        if s3fs is None:\n835\t            raise ImportError(\"s3fs is required. Install via: pip install s3fs fsspec\")\n836\t        if self._s3fs is None:\n837\t            self._s3fs = s3fs.S3FileSystem(**self.s3fs_kwargs, **self.s3_storage_options)\n838\t        return self._s3fs\n839\t\n840\t    def _s3_cache_path(self, s3_uri: str) -> str:\n841\t        \"\"\"Build a stable, human-readable local cache path for an S3 object.\"\"\"\n842\t        bucket, key = parse_s3_uri(s3_uri)\n843\t        base = os.path.basename(key) or \"object\"\n844\t        base_safe = re.sub(r\"[^A-Za-z0-9._-]+\", \"_\", base).strip(\"._-\") or \"object\"\n845\t        _, ext = os.path.splitext(base_safe)\n846\t        suffix = ext if ext else \".nc\"\n847\t        key_hash = hashlib.sha1(f\"{bucket}/{key}\".encode()).hexdigest()\n848\t        fname = f\"{bucket}__{key_hash}__{base_safe}\"\n849\t        if not fname.endswith(suffix):\n850\t            fname += suffix\n851\t        return os.path.join(self.s3_temp_dir, fname)\n852\t\n853\t    def _download_s3_object(self, s3_uri: str, local_path: str) -> None:\n854\t        \"\"\"Download an S3 object to ``local_path``.\n855\t\n856\t        Uses boto3's transfer manager when available (parallel multipart downloads),\n857\t        otherwise falls back to streaming via s3fs.\n858\t        \"\"\"\n859\t        os.makedirs(os.path.dirname(local_path) or \".\", exist_ok=True)\n860\t\n861\t        if boto3 is not None:\n862\t            anon = bool(self.s3_storage_options.get(\"anon\") or self.s3fs_kwargs.get(\"anon\"))\n863\t            region = (os.environ.get(\"AWS_REGION\")\n864\t                      or os.environ.get(\"AWS_DEFAULT_REGION\")\n865\t                      or detect_ec2_region())\n866\t            client = make_s3_client(\n867\t                anon=anon,\n868\t                region=region,\n869\t                # Pool must exceed the thread count or multipart threads contend.\n870\t                pool_size=max(32, self.s3_boto3_max_concurrency * 2),\n871\t                # Retry hard: a failed read kills the training run.\n872\t                max_attempts=10,\n873\t            )\n874\t\n875\t            transfer_cfg = TransferConfig(\n876\t                multipart_threshold=self.s3_boto3_part_size_mb * 1024 * 1024,\n877\t                multipart_chunksize=self.s3_boto3_part_size_mb * 1024 * 1024,\n878\t                max_concurrency=self.s3_boto3_max_concurrency,\n879\t                use_threads=True,\n880\t                io_chunksize=1024 * 1024,\n881\t            )\n882\t            bucket, key = parse_s3_uri(s3_uri)\n883\t            client.download_file(bucket, key, local_path, Config=transfer_cfg)\n884\t            return\n885\t\n886\t        # Fallback: stream via s3fs\n887\t        fs = self._get_s3fs()\n888\t        with fs.open(s3_uri, \"rb\") as src, open(local_path, \"wb\") as dst:\n889\t            for chunk in iter(lambda: src.read(8 * 1024 * 1024), b\"\"):\n890\t                dst.write(chunk)\n891\t\n892\t    # ------------------------------------------------------------------\n893\t    # Normalization\n894\t    # ------------------------------------------------------------------\n895\t",
