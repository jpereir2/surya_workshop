      "metadata": {
        "tool_calls": [
          {
            "title": "cat > run_flip_check.py <<'PYEOF' # Mirrors the notebook's minimum path: cells 2,3,5,7,10,11,17,19,21,23 then cell 29 parts A+B. import os, sys, time os.environ[\"CUDA_VISIBLE_DEVICES\"] = \"0\" os.environ.setdefault(\"CUBLAS_WORKSPACE_CONFIG\", \":4096:8\") import torch sys.path.append(\"../../\") from workshop_infrastructure.utils import build_scalers, load_pretrained_weights torch.set_float32_matmul_precision(\"medium\") T0 = time.time() def log(msg): print(f\"[{time.time()-T0:7.1f}s] {msg}\", flush=True) # ---- cell 5 from downstream_apps.flare_forecast.configs import load_flare_config cfg = load_flare_config(\"./configs/config_script.yaml\") log(f\"config: job={cfg.job_id} batch_size={cfg.batch_size} dtype={cfg.dtype}\") # ---- cell 7 from workshop_infrastructure.assets import ensure_assets ensure_assets(cfg, which=[\"scalers\", \"weights\"]) scalers = build_scalers(info=cfg.data.scalers_path) log(f\"scalers for {len(scalers)} channels\") # ---- cells 10, 11 (max_number_of_samples=2 for the minimum check) from downstream_apps.flare_forecast.datasets.flare_dataset import flare_Dataset from workshop_infrastructure.datasets.builders import build_helio_dataloaders train_data_loader, val_data_loader = build_helio_dataloaders( cfg, flare_Dataset, scalers=scalers, num_workers=0, return_surya_stack=True, max_number_of_samples=2, flip_probability=0.5, ds_flare_index_path=cfg.data.flare_index_path, ds_time_column=cfg.data.ds_time_column, ds_time_tolerance=cfg.data.ds_time_tolerance, ds_match_direction=cfg.data.ds_match_direction, ) log(f\"train {len(train_data_loader.dataset)} | val {len(val_data_loader.dataset)} samples\") # ---- cells 17, 19 from workshop_infrastructure.models.finetune_models import HelioSpectformer2D model = HelioSpectformer2D.from_config( cfg.model, ft_out_chans=len(cfg.data.channels), ft_unembedding_type=\"linear\", dtype=cfg.dtype, use_latitude_in_learned_flow=cfg.use_latitude_in_learned_flow, ) log(\"model built\") # ---- cell 21 load_pretrained_weights(model, cfg.model.pretrained_path) # ---- cell 23 (the decoder fix) _ckpt = torch.load(cfg.model.pretrained_path, weights_only=True, map_location=\"cpu\") _msd = model.state_dict() _copied = [] for _k, _v in _ckpt.items(): _target = f\"head_{_k}\" if _target in _msd: assert _v.shape == _msd[_target].shape, f\"shape mismatch {_target}\" _msd[_target] = _v _copied.append((_k, _target, tuple(_v.shape))) assert _copied, f\"no head_* match; unembed keys = {[k for k in _ckpt if k.startswith('unembed')]}\" model.load_state_dict(_msd, strict=True) log(f\"decoder fix copied {len(_copied)} tensors: \" + \", \".join(f\"{k}->{t} {s}\" for k, t, s in _copied)) del _ckpt, _msd # ---- cell 29, parts A and B import numpy as np, pandas as pd dev = \"cuda\" if torch.cuda.is_available() else \"cpu\" _KEYS = (\"ts\", \"time_delta_input\", \"lead_time_delta\") mse = lambda a, b: torch.mean((a.float() - b.float()) ** 2).item() def as_batch(sample): b = {k: torch.as_tensor(sample[k])[None].to(dev) for k in _KEYS} tgt = torch.as_tensor(sample[\"forecast\"])[None][:, :, 0].to(dev) return b, tgt ds = train_data_loader.dataset ds.flip_probability = 0.0 s_up = ds[0] log(\"read sample 0 upright\") ds.flip_probability = 1.0 s_fl = ds[0] log(\"read sample 0 flipped\") assert not s_up[\"was_flipped\"], \"p=0.0 still reported was_flipped=True\" assert s_fl[\"was_flipped\"], \"p=1.0 did not report was_flipped=True\" assert np.array_equal(s_fl[\"ts\"], np.flip(s_up[\"ts\"], axis=-2)), \"input not flipped as expected\" assert np.array_equal(s_fl[\"forecast\"], np.flip(s_up[\"forecast\"], axis=-2)), \\ \"TARGET not flipped with the input\" print(\"\\nA. PASS - flip fires, is recorded in was_flipped, and flips BOTH input and target.\\n\", flush=True) del s_up, s_fl model = model.to(dev).eval() rows = [] for split, dl in ((\"train\", train_data_loader), (\"val\", val_data_loader)): d = dl.dataset d.flip_probability = 0.0 for i in range(len(d)): s = d[i] b, tgt = as_batch(s) for orient in (\"upright\", \"flipped\"): bb, t = dict(b), tgt if orient == \"flipped\": bb[\"ts\"] = torch.flip(b[\"ts\"], dims=[-2]) t = torch.flip(tgt, dims=[-2]) t0 = time.perf_counter() with torch.no_grad(), torch.autocast(device_type=dev, dtype=torch.bfloat16): pred = model(bb).float() if dev == \"cuda\": torch.cuda.synchronize() rows.append({\"split\": split, \"i\": i, \"time\": s[\"ds_index\"][:16], \"orientation\": orient, \"error\": mse(pred, t), \"persistence\": mse(bb[\"ts\"][:, :, -1], t)}) log(f\"B: {split} {i} {orient:8s} fwd {time.perf_counter()-t0:5.1f}s \" f\"err {rows[-1]['error']:.4f}\") del bb, t, pred del b, tgt tab = pd.DataFrame(rows) print(\"\\n\" + tab.to_string(index=False), flush=True) print(\"\\n\" + tab.groupby([\"split\", \"orientation\"])[[\"error\", \"persistence\"]].mean().to_string()) _p = tab.pivot_table(index=[\"split\", \"i\"], columns=\"orientation\", values=\"persistence\") _gap = (_p[\"upright\"] - _p[\"flipped\"]).abs().max() print(f\"\\npersistence gap across orientations: {_gap:.3e} (must be ~0)\") assert _gap < 1e-4, f\"persistence differs by {_gap:.2e} -- flip inconsistent\" _m = tab.pivot_table(index=[\"split\", \"i\"], columns=\"orientation\", values=\"error\") print(f\"mean error, flipped minus upright: {(_m['flipped'] - _m['upright']).mean():+.4f}\") print(\"per-sample flipped minus upright:\") print((_m[\"flipped\"] - _m[\"upright\"]).to_string()) if dev == \"cuda\": print(f\"\\npeak GPU memory: {torch.cuda.max_memory_allocated()/2**30:.1f} GB of \" f\"{torch.cuda.get_device_properties(0).total_memory/2**30:.0f} GB\") log(\"DONE\") PYEOF cd flare_forecast && python run_flip_check.py 2>&1 | tail -60",
