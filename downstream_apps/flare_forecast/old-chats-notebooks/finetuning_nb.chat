      "type": "msg",
      "mentions": [],
      "time": 1789585164.8601336,
      "metadata": {
        "tool_calls": [
          {
            "session_id": "86e6be9a-1e6b-4679-972f-8d7b8a07afbb",
            "permission_options": [
