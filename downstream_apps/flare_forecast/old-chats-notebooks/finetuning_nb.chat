              "command": "cd /home/jovyan/tmp/surya_workshop && sed -n '230,300p' workshop_infrastructure/models/finetune_models.py; echo \"=== backbone forward: what batch keys are read ===\"; grep -n 'batch\\[' workshop_infrastructure/models/helio_spectformer.py | head -20"
