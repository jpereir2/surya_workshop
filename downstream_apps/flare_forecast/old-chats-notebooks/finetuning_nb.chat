            "tool_call_id": "toolu_bdrk_01RD6hZqHdqrA7emcvzzWpKT",
            "title": "cd flare_forecast && python - <<'PYEOF' import json, ast, nbformat NB = \"2b_flip_minimal.ipynb\" nb = json.load(open(NB)) s = nb[\"cells\"][15][\"source\"] i = next(n for n, l in enumerate(s) if l.startswith(' print(\"\\\\n\" + \"=\" * 100')) s[i + 1:i + 1] = [ ' # The tag must be the sample\\'s own recorded orientation -- nothing here forces it.\\n', ' assert bool(item[\"was_flipped\"]) == (ORIENT == \"FLIPPED\"), \"tag/was_flipped disagree\"\\n', ] json.dump(nb, open(NB, \"w\"), indent=1) _nb = nbformat.read(NB, as_version=4) nbformat.validate(_nb) for c in _nb.cells: if c[\"cell_type\"] == \"code\": ast.parse(\"\".join(c[\"source\"])) print(f\"{len(_nb.cells)} cells, valid, all parse\\n\") for n, c in enumerate(_nb.cells): l = \"\".join(c[\"source\"]).strip().split(\"\\n\") print(f\"{n:3d} {c['cell_type'][:4]:4s} {len(l):4d}ln | {(l[0] if l else '(empty)')[:64]}\") PYEOF",
