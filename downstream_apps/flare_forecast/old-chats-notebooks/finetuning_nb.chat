            "title": "cd surya_workshop && sed -n '880,960p' workshop_infrastructure/datasets/helio.py && echo \"=== LinearDecoder / PerceiverDecoder ===\" && grep -n \"class LinearDecoder\" -A 60 workshop_infrastructure/models/embedding.py",
