            "raw_output": "500\t        self.logger: Logger | None = None\n501\t\n502\t        # Every requested channel must have a scaler. Checking here turns what would\n503\t        # otherwise be a bare `KeyError: 'aia1700'` from the comprehension below into a\n504\t        # message naming the config key, the missing channels, and the valid ones.\n505\t        missing = [ch for ch in self.channels if ch not in self.scalers]\n506\t        if missing:\n507\t            raise ValueError(\n508\t                f\"No scaler found for channel(s): {', '.join(missing)}.\\n\"\n509\t                \"Every entry in data.channels must have matching statistics in your \"\n510\t                \"scalers file (data.scalers_path).\\n\"\n511\t                f\"Channels available in the scalers: {', '.join(sorted(self.scalers))}.\\n\"\n512\t                \"Either correct the channel name in the config or use a scalers file that \"\n513\t                \"covers it.\"\n514\t            )\n515\t\n516\t        # Pre-compute normalization arrays once (avoids repeated dict lookups per sample).\n517\t        self._means = np.array([self.scalers[ch].mean for ch in self.channels])\n518\t        self._stds = np.array([self.scalers[ch].std for ch in self.channels])\n519\t        self._epsilons = np.array([self.scalers[ch].epsilon for ch in self.channels])\n520\t        self._sl_scale_factors = np.array([self.scalers[ch].sl_scale_factor for ch in self.channels])\n521\t\n522\t    # ------------------------------------------------------------------\n523\t    # Index filtering\n524\t    # ------------------------------------------------------------------\n525\t\n526\t    def _filter_valid_indices(self) -> list:\n527\t        \"\"\"Return the list of reference timesteps for which all required offsets are present.\n528\t\n529\t        When ``load_forecast_frames=False``, only input-frame offsets are checked, so the\n530\t        index does not need to contain future timestamps.\n531\t        \"\"\"\n532\t        if self.load_forecast_frames:\n533\t            # `+` concatenates two Python lists of np.timedelta64 objects before deduplication.\n534\t            time_deltas = np.unique(self.time_delta_input_minutes + self.time_delta_target_minutes)\n535\t        else:\n536\t            time_deltas = np.unique(self.time_delta_input_minutes)\n537\t        return [\n538\t            ts for ts in self.index.index\n539\t            if all(ts + dt in self.index.index for dt in time_deltas)\n540\t        ]\n541\t\n542\t    # ------------------------------------------------------------------\n543\t    # Logging\n544\t    # ------------------------------------------------------------------\n545\t\n546\t    def _ensure_logger(self):\n547\t        \"\"\"Create a per-process logger on first use.\"\"\"\n548\t        if self.logger is not None:\n549\t            return\n550\t        os.makedirs(\"logs/data\", exist_ok=True)\n551\t        timestamp = datetime.now().strftime(\"%Y%m%dT%H%M%SZ\")\n552\t        pid = os.getpid()\n553\t        self.logger = create_logger(\n554\t            output_dir=\"logs/data\",\n555\t            dist_rank=self.rank,\n556\t            name=f\"{timestamp}_{self.rank:>03}_data_{self.phase}_{pid}\",\n557\t        )\n558\t\n559\t    # ------------------------------------------------------------------\n560\t    # Dataset interface\n561\t    # ------------------------------------------------------------------\n562\t\n563\t    def __len__(self) -> int:\n564\t        \"\"\"Return the number of valid reference timesteps in this dataset.\"\"\"\n565\t        return self.adjusted_length\n566\t\n567\t    def __getitem__(self, idx: int) -> dict:\n568\t        \"\"\"\n569\t        Load and return a single sample.\n570\t\n571\t        Args:\n572\t            idx: Dataset index.\n573\t\n574\t        Returns:\n575\t            Dictionary with keys:\n576\t                ts (np.ndarray):               (C, T, H, W) \u2014 input frames\n577\t                time_delta_input (np.ndarray): (T,) \u2014 input time offsets in hours (relative to \"now\")\n578\t            When ``load_forecast_frames=True`` (default), also includes:\n579\t                forecast (np.ndarray):         (C, L, H, W) \u2014 target frames\n580\t                lead_time_delta (np.ndarray):  (L,) \u2014 lead times in hours (negative = future)\n581\t            When ``use_latitude_in_learned_flow=True``, also includes:\n582\t                input_latitudes (list[float])\n583\t                forecast_latitude (list[float])  \u2014 only when ``load_forecast_frames=True``\n584\t        \"\"\"\n585\t        self._ensure_logger()\n586\t        self.logger.info(f\"Retrieving index {idx}.\")\n587\t        return self._get_index_data(idx)\n588\t\n589\t    # ------------------------------------------------------------------\n590\t    # Internal data loading\n591\t    # ------------------------------------------------------------------\n592\t\n593\t    def _load_and_stack_frames(self, timesteps) -> np.ndarray:\n594\t        \"\"\"Load, normalize, and stack NetCDF frames into a (C, T, H, W) array.\n595\t\n596\t        Args:\n597\t            timesteps: Sequence of timestamps; one NetCDF file is loaded per entry.\n598\t\n599\t        Returns:\n600\t            NumPy array of shape (C, T, H, W).\n601\t        \"\"\"\n602\t        return np.stack(\n603\t            [self.transform_data(self.load_nc_data(self.index.loc[ts, \"path\"], ts, self.channels))\n604\t             for ts in timesteps],\n605\t            axis=1,\n606\t        )\n607\t\n608\t    def _get_index_data(self, idx: int) -> dict:\n609\t        \"\"\"Build and return the sample dict for a single reference timestep.\n610\t\n611\t        Samples historical input frames randomly from ``time_delta_input_minutes``,\n612\t        applies channel masking and optional vertical flip, then assembles the sample\n613\t        dict described in ``__getitem__``.\n614\t        \"\"\"\n615\t        reference_timestep = self.valid_indices[idx]\n616\t\n617\t        # The last entry in time_delta_input_minutes is always the \"now\" frame (offset 0\n618\t        # relative to the reference timestep). The remaining n-1 input frames are sampled\n619\t        # randomly from the earlier offsets, giving the model varied historical context\n620\t        # across training steps.\n621\t        input_time_deltas = np.array(\n622\t            sorted(random.sample(self.time_delta_input_minutes[:-1], self.n_input_timestamps - 1))\n623\t            + [self.time_delta_input_minutes[-1]]\n624\t        )\n625\t        input_timesteps = reference_timestep + input_time_deltas\n626\t        stacked_inputs = self._load_and_stack_frames(input_timesteps)\n627\t\n628\t        if self.num_mask_aia_channels > 0 or self.drop_hmi_probability:\n629\t            stacked_inputs = self.masker(stacked_inputs)\n630\t\n631\t        # All time deltas are expressed relative to \"now\" (the last input frame), in hours.\n632\t        now_delta = input_time_deltas[-1]\n633\t        time_delta_input_float = (\n634\t            (now_delta - input_time_deltas) / np.timedelta64(1, \"h\")\n635\t        ).astype(np.float32)\n636\t\n637\t        sample = {\n638\t            \"ts\": stacked_inputs,\n639\t            \"time_delta_input\": time_delta_input_float,\n640\t        }\n641\t\n642\t        if self.load_forecast_frames:\n643\t            target_time_deltas = np.array(self.time_delta_target_minutes)\n644\t            target_timesteps = reference_timestep + target_time_deltas\n645\t            sample[\"forecast\"] = self._load_and_stack_frames(target_timesteps)\n646\t            sample[\"lead_time_delta\"] = (\n647\t                (now_delta - target_time_deltas) / np.timedelta64(1, \"h\")\n648\t            ).astype(np.float32)\n649\t\n650\t        if self.random_vert_flip and torch.bernoulli(torch.ones(()) / 2) == 1:\n651\t            sample[\"ts\"] = np.flip(sample[\"ts\"], axis=-2).copy()\n652\t            if self.load_forecast_frames:\n653\t                sample[\"forecast\"] = np.flip(sample[\"forecast\"], axis=-2).copy()\n654\t\n655\t        if self.use_latitude_in_learned_flow:\n656\t            from sunpy.coordinates.ephemeris import get_earth\n657\t\n658\t            sample[\"input_latitudes\"] = [get_earth(ts).lat.value for ts in input_timesteps]\n659\t            if self.load_forecast_frames:\n660\t                sample[\"forecast_latitude\"] = [get_earth(ts).lat.value for ts in target_timesteps]\n661\t\n662\t        return sample\n663\t\n664\t    # ------------------------------------------------------------------\n665\t    # NetCDF loading\n666\t    # ------------------------------------------------------------------\n667\t\n668\t    def load_nc_data(self, filepath: str, timestep: pd.Timestamp, channels: list[str]) -> np.ndarray:\n669\t        \"\"\"\n670\t        Load a NetCDF file and return channel-stacked data as a NumPy array.\n671\t\n672\t        Supports both local filesystem paths and S3 URIs (``s3://bucket/key``).\n673\t        How S3 objects are read is controlled by ``s3_mode`` (default: download the\n674\t        whole object into ``s3_cache_dir``, then open it locally).\n675\t\n676\t        Args:\n677\t            filepath: Local path or S3 URI.\n678\t            timestep: Timestamp for the file (used for logging).\n679\t            channels: List of variable names to extract, stacked into (C, H, W).",
