            "kind": "execute",
            "raw_input": {
              "command": "grep -v \"FutureWarning\\|warnings.warn\" /tmp/budget.log 2>/dev/null; pgrep -f t_budget.py >/dev/null && echo \"STILL RUNNING\" || echo \"stopped\""
            },
            "raw_output": "[   11.7s] 13 warm / 6266 cold train samples\n[  101.2s] A. WARM read per sample: 22.4s  (each ['24.7', '21.2', '20.9', '22.6'])\n[  101.4s] B. mean cached file size 560 MB  -> 1.64 GB per sample (3 frames)\n[  290.4s] C. COLD read serial: 63.0s/sample  (each ['54.0', '66.3', '68.7'])  -> download share ~63.0s\nSTILL RUNNING"
