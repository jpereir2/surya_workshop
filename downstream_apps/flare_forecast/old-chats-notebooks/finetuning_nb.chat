            "title": "cd surya_workshop && cat > t_lit.py <<'EOF' import sys, torch, lightning as L from torch.utils.data import DataLoader, Dataset sys.path.insert(0,'.') from workshop_infrastructure.models.finetune_models import HelioSpectformer2D from workshop_infrastructure.utils import apply_peft_lora from workshop_infrastructure.configs import LoraAdapterConfig from downstream_apps.flare_forecast.metrics.flare_metrics import FlareMetrics from downstream_apps.flare_forecast.lightning_modules.pl_flare_baseline import FlareLightningModule IMG, PS, C, T = 128, 16, 13, 2 model = HelioSpectformer2D( img_size=IMG, patch_size=PS, in_chans=C, embed_dim=64, time_embedding={\"type\":\"linear\",\"time_dim\":T,\"n_queries\":None}, depth=2, n_spectral_blocks=1, num_heads=4, mlp_ratio=4.0, drop_rate=0.0, window_size=2, dp_rank=2, dtype=torch.float32, checkpoint_layers=[0,1], ft_unembedding_type=\"linear\", ft_out_chans=C, ) model = apply_peft_lora(model, LoraAdapterConfig(r=8, lora_alpha=8, lora_dropout=0.1, bias=\"none\", target_modules=[\"q_proj\",\"v_proj\",\"k_proj\",\"out_proj\",\"fc1\",\"fc2\"])) # ---- EXACT cell 35 code ---- class Flare2DLightningModule(FlareLightningModule): \"\"\"FlareLightningModule with a 2D image target instead of a scalar label.\"\"\" @staticmethod def _target(batch): fc = batch[\"forecast\"] assert fc.shape[2] == 1, ( f\"expected one target frame, got {fc.shape[2]}. Set training.rollout_steps: 0.\" ) return fc[:, :, 0].float() # (B, C, H, W) def _step(self, batch, stage): target = self._target(batch) if self.preprocess_fn is not None: batch = self.preprocess_fn(batch) output = self(batch) loss_fn = self.training_loss if stage == \"train\" else self.validation_loss eval_fn = self.training_evaluation if stage == \"train\" else self.validation_evaluation losses, weights = loss_fn(output, target) loss = self._combine_losses(losses, weights) self.log(f\"{stage}_loss\", loss, prog_bar=True, batch_size=self.batch_size, sync_dist=True) for k, v in losses.items(): self.log(f\"{stage}_loss_{k}\", v, batch_size=self.batch_size, sync_dist=True) mets, mw = eval_fn(output, target) if len(mw) > 0: for k, v in mets.items(): self.log(f\"{stage}_metric_{k}\", v, batch_size=self.batch_size, sync_dist=True) return loss def training_step(self, batch, batch_idx): return self._step(batch, \"train\") def validation_step(self, batch, batch_idx): self._step(batch, \"val\") # ---- end cell 35 ---- class DS(Dataset): def __len__(self): return 4 def __getitem__(self, i): return { \"ts\": torch.randn(C, T, IMG, IMG), \"time_delta_input\": torch.tensor([-60.0, -36.0]), \"forecast\": torch.randn(C, 1, IMG, IMG), \"lead_time_delta\": torch.tensor([0.0]), \"ground_truth\": torch.tensor(1.0), \"ds_index\": \"2011-01-01T00:00:00\", \"was_flipped\": torch.tensor(False), } dl = DataLoader(DS(), batch_size=2) metrics = {'train_loss': FlareMetrics(\"train_loss\"), 'val_loss': FlareMetrics(\"val_loss\"), 'train_metrics': FlareMetrics(\"train_metrics\"), 'val_metrics': FlareMetrics(\"val_metrics\")} lit = Flare2DLightningModule(model, metrics, lr=1e-4, batch_size=2) print(\"INIT OK:\", type(lit).__name__) from lightning.pytorch.callbacks import ModelCheckpoint tr = L.Trainer(max_epochs=2, accelerator=\"cpu\", devices=1, logger=False, enable_progress_bar=False, enable_model_summary=False, callbacks=[ModelCheckpoint(monitor=\"val_loss\", mode=\"min\", save_top_k=1, dirpath=\"/tmp/ckpt_t\")], log_every_n_steps=1) tr.fit(lit, dl, dl) print(\"FIT OK. logged:\", {k: round(float(v),4) for k,v in tr.callback_metrics.items()}) print(\"best ckpt:\", tr.checkpoint_callback.best_model_path != \"\") EOF python t_lit.py 2>&1 | tail -35",
            "raw_input": {
              "command": "cd /home/jovyan/tmp/surya_workshop && cat > /tmp/t_lit.py <<'EOF'\nimport sys, torch, lightning as L\nfrom torch.utils.data import DataLoader, Dataset\nsys.path.insert(0,'.')\nfrom workshop_infrastructure.models.finetune_models import HelioSpectformer2D\nfrom workshop_infrastructure.utils import apply_peft_lora\nfrom workshop_infrastructure.configs import LoraAdapterConfig\nfrom downstream_apps.flare_forecast.metrics.flare_metrics import FlareMetrics\nfrom downstream_apps.flare_forecast.lightning_modules.pl_flare_baseline import FlareLightningModule\n\nIMG, PS, C, T = 128, 16, 13, 2\nmodel = HelioSpectformer2D(\n    img_size=IMG, patch_size=PS, in_chans=C, embed_dim=64,\n    time_embedding={\"type\":\"linear\",\"time_dim\":T,\"n_queries\":None},\n    depth=2, n_spectral_blocks=1, num_heads=4, mlp_ratio=4.0, drop_rate=0.0,\n    window_size=2, dp_rank=2, dtype=torch.float32, checkpoint_layers=[0,1],\n    ft_unembedding_type=\"linear\", ft_out_chans=C,\n)\nmodel = apply_peft_lora(model, LoraAdapterConfig(r=8, lora_alpha=8, lora_dropout=0.1,\n    bias=\"none\", target_modules=[\"q_proj\",\"v_proj\",\"k_proj\",\"out_proj\",\"fc1\",\"fc2\"]))\n\n# ---- EXACT cell 35 code ----\nclass Flare2DLightningModule(FlareLightningModule):\n    \"\"\"FlareLightningModule with a 2D image target instead of a scalar label.\"\"\"\n\n    @staticmethod\n    def _target(batch):\n        fc = batch[\"forecast\"]\n        assert fc.shape[2] == 1, (\n            f\"expected one target frame, got {fc.shape[2]}. Set training.rollout_steps: 0.\"\n        )\n        return fc[:, :, 0].float()          # (B, C, H, W)\n\n    def _step(self, batch, stage):\n        target = self._target(batch)\n        if self.preprocess_fn is not None:\n            batch = self.preprocess_fn(batch)\n        output = self(batch)\n        loss_fn = self.training_loss if stage == \"train\" else self.validation_loss\n        eval_fn = self.training_evaluation if stage == \"train\" else self.validation_evaluation\n        losses, weights = loss_fn(output, target)\n        loss = self._combine_losses(losses, weights)\n        self.log(f\"{stage}_loss\", loss, prog_bar=True, batch_size=self.batch_size, sync_dist=True)\n        for k, v in losses.items():\n            self.log(f\"{stage}_loss_{k}\", v, batch_size=self.batch_size, sync_dist=True)\n        mets, mw = eval_fn(output, target)\n        if len(mw) > 0:\n            for k, v in mets.items():\n                self.log(f\"{stage}_metric_{k}\", v, batch_size=self.batch_size, sync_dist=True)\n        return loss\n\n    def training_step(self, batch, batch_idx):   return self._step(batch, \"train\")\n    def validation_step(self, batch, batch_idx): self._step(batch, \"val\")\n# ---- end cell 35 ----\n\nclass DS(Dataset):\n    def __len__(self): return 4\n    def __getitem__(self, i):\n        return {\n            \"ts\": torch.randn(C, T, IMG, IMG),\n            \"time_delta_input\": torch.tensor([-60.0, -36.0]),\n            \"forecast\": torch.randn(C, 1, IMG, IMG),\n            \"lead_time_delta\": torch.tensor([0.0]),\n            \"ground_truth\": torch.tensor(1.0),\n            \"ds_index\": \"2011-01-01T00:00:00\",\n            \"was_flipped\": torch.tensor(False),\n        }\ndl = DataLoader(DS(), batch_size=2)\n\nmetrics = {'train_loss': FlareMetrics(\"train_loss\"), 'val_loss': FlareMetrics(\"val_loss\"),\n           'train_metrics': FlareMetrics(\"train_metrics\"), 'val_metrics': FlareMetrics(\"val_metrics\")}\nlit = Flare2DLightningModule(model, metrics, lr=1e-4, batch_size=2)\nprint(\"INIT OK:\", type(lit).__name__)\n\nfrom lightning.pytorch.callbacks import ModelCheckpoint\ntr = L.Trainer(max_epochs=2, accelerator=\"cpu\", devices=1, logger=False,\n               enable_progress_bar=False, enable_model_summary=False,\n               callbacks=[ModelCheckpoint(monitor=\"val_loss\", mode=\"min\", save_top_k=1, dirpath=\"/tmp/ckpt_t\")],\n               log_every_n_steps=1)\ntr.fit(lit, dl, dl)\nprint(\"FIT OK. logged:\", {k: round(float(v),4) for k,v in tr.callback_metrics.items()})\nprint(\"best ckpt:\", tr.checkpoint_callback.best_model_path != \"\")\nEOF\n/home/jovyan/envs/surya_ws/bin/python /tmp/t_lit.py 2>&1 | tail -35"
