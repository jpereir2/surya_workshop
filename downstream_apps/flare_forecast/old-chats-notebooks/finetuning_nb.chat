            "title": "cd surya_workshop && python - <<'EOF' import pandas as pd, numpy as np fl=pd.read_csv(\"downstream_apps/flare_forecast/data/hek_flare_catalog.csv\") fl[\"ds_index\"]=pd.to_datetime(fl[\"peak_time\"]) fl=fl.sort_values(\"ds_index\") for name in [\"surya_aws_s3_train.csv\",\"surya_aws_s3_val.csv\"]: d=pd.read_csv(f\"data/indices/{name}\", parse_dates=[\"timestep\"]) d=d[d.present==1] have=set(d.timestep) # valid reference timesteps need t-60, t-36, t ok=[t for t in sorted(have) if (t-pd.Timedelta(minutes=60)) in have and (t-pd.Timedelta(minutes=36)) in have] v=pd.DataFrame({\"valid_indices\":pd.DatetimeIndex(ok)}) m=pd.merge_asof(v, fl[[\"ds_index\",\"CMX\",\"GOES_class\"]], left_on=\"valid_indices\", right_on=\"ds_index\", direction=\"forward\") m[\"delta\"]=(m.ds_index-m.valid_indices).abs() m=m.sort_values([\"ds_index\",\"delta\"]).drop_duplicates(\"ds_index\", keep=\"first\") print(f\"\\n=== {name}: valid ref timesteps={len(ok):,}\") for tol in [\"4d\",\"1h\",\"12m\"]: s=m[m.delta<=pd.Timedelta(tol)] yr=s.valid_indices.dt.year print(f\" tol={tol:>4s}: {len(s):5d} samples | M/X={len(s[s.CMX.isin(['M','X'])]):4d} \" f\"| median delta={s.delta.median()}\") if tol==\"12m\": print(\" per-year:\", dict(yr.value_counts().sort_index())) print(\" M/X per-year:\", dict(s[s.CMX.isin(['M','X'])].valid_indices.dt.year.value_counts().sort_index())) EOF",
            "raw_input": {
              "command": "cd /home/jovyan/tmp/surya_workshop && /home/jovyan/envs/surya_ws/bin/python - <<'EOF'\nimport pandas as pd, numpy as np\nfl=pd.read_csv(\"downstream_apps/flare_forecast/data/hek_flare_catalog.csv\")\nfl[\"ds_index\"]=pd.to_datetime(fl[\"peak_time\"])\nfl=fl.sort_values(\"ds_index\")\n\nfor name in [\"surya_aws_s3_train.csv\",\"surya_aws_s3_val.csv\"]:\n    d=pd.read_csv(f\"data/indices/{name}\", parse_dates=[\"timestep\"])\n    d=d[d.present==1]\n    have=set(d.timestep)\n    # valid reference timesteps need t-60, t-36, t\n    ok=[t for t in sorted(have)\n        if (t-pd.Timedelta(minutes=60)) in have and (t-pd.Timedelta(minutes=36)) in have]\n    v=pd.DataFrame({\"valid_indices\":pd.DatetimeIndex(ok)})\n    m=pd.merge_asof(v, fl[[\"ds_index\",\"CMX\",\"GOES_class\"]], left_on=\"valid_indices\",\n                    right_on=\"ds_index\", direction=\"forward\")\n    m[\"delta\"]=(m.ds_index-m.valid_indices).abs()\n    m=m.sort_values([\"ds_index\",\"delta\"]).drop_duplicates(\"ds_index\", keep=\"first\")\n    print(f\"\\n=== {name}: valid ref timesteps={len(ok):,}\")\n    for tol in [\"4d\",\"1h\",\"12m\"]:\n        s=m[m.delta<=pd.Timedelta(tol)]\n        yr=s.valid_indices.dt.year\n        print(f\"  tol={tol:>4s}: {len(s):5d} samples | M/X={len(s[s.CMX.isin(['M','X'])]):4d} \"\n              f\"| median delta={s.delta.median()}\")\n        if tol==\"12m\":\n            print(\"      per-year:\", dict(yr.value_counts().sort_index()))\n            print(\"      M/X per-year:\", dict(s[s.CMX.isin(['M','X'])].valid_indices.dt.year.value_counts().sort_index()))\nEOF"
