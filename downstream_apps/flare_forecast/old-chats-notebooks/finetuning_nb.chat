            "raw_output": "231:def discover_head_modules(model: torch.nn.Module) -> list[str]:\n232-    \"\"\"Find the fine-tuning head modules to keep trainable under LoRA.\n233-\n234-    Convention: every trainable component of a fine-tuning head is a **direct\n235-    child** of the top-level model whose attribute name starts with ``head_``\n236-    (e.g. ``head_linear``, ``head_unembed``, ``head_cls_token``).  The backbone\n237-    stays at ``backbone``.  Learners therefore never hand-maintain a list of\n238-    head layers -- adding ``self.head_foo = nn.Linear(...)`` is enough.\n239-\n240-    Only modules that own parameters are returned, so parameter-free layers\n241-    such as ``head_dropout`` are not needlessly duplicated by PEFT.\n242-\n243-    Raises:\n244-        ValueError: if the model violates the convention, with a message\n245-            naming the exact attribute to rename.\n246-    \"\"\"\n247-    head_names = []\n248-    missing_prefix = []\n249-    for name, module in model.named_children():\n250-        has_params = any(True for _ in module.parameters())\n251-        if name.startswith(HEAD_PREFIX):\n252-            if has_params:\n253-                head_names.append(name)\n254-        elif name != \"backbone\" and has_params:\n255-            missing_prefix.append(name)\n256-\n257-    if missing_prefix:\n258-        raise ValueError(\n259-            \"Fine-tuning head modules must be named with the \"\n260-            f\"{HEAD_PREFIX!r} prefix so LoRA can keep them trainable.\\n\"\n261-            f\"Rename these top-level attributes: \"\n262-            + \", \".join(f\"self.{n} -> self.{HEAD_PREFIX}{n}\" for n in missing_prefix)\n263-            + \"\\nWithout the prefix they are frozen during LoRA fine-tuning and \"\n264-            \"the model trains against a random readout.\"\n265-        )\n266-\n267-    # PEFT's modules_to_save cannot cover a bare nn.Parameter on the top-level\n268-    # model -- it would stay frozen.  Wrap it in a tiny module instead.\n269-    bare = [n for n, _ in model.named_parameters(recurse=False)]\n270-    if bare:\n271-        raise ValueError(\n272-            \"Top-level bare parameters cannot be kept trainable by PEFT, which \"\n273-            \"matches module names only, so these would be silently frozen: \"\n274-            + \", \".join(bare)\n275-            + \"\\nWrap each one in a small nn.Module (see ClassToken in \"\n276-            \"workshop_infrastructure/models/finetune_models.py) and name the \"\n=== out_proj/q_proj in models? ===\nShell cwd was reset to /home/jovyan/tmp/surya_workshop/downstream_apps/flare_forecast/old-chats-notebooks",
