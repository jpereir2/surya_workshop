\n749:        cache_path = self._s3_cache_path(s3_uri)\n750:        os.makedirs(os.path.dirname(cache_path) or \".\", exist_ok=True)\n752:        if not os.path.exists(cache_path):\n753:            tmp_path = f\"{cache_path}.{os.getpid()}.{uuid4().hex}.partial\"\n755:                self._download_s3_object(s3_uri, tmp_path)\n758:                os.replace(tmp_path, cache_path)\n760:                if os.path.exists(tmp_path):\n761:                    os.remove(tmp_path)\n764:        with xr.open_dataset(cache_path, engine=\"h5netcdf\", chunks=None, cache=False) as ds:\n771:    def _is_s3_path(self, path: str) -> bool:\n772:        \"\"\"Return True if ``path`` is an S3 URI (starts with ``s3://``).\"\"\"\n773:        return isinstance(path, str) and path.startswith(\"s3://\")\n781:                return os.path.join(root, \"helio_s3_cache\")\n782:        return os.path.join(os.path.expanduser(\"~\"), \".cache\", \"surya_workshop\", \"helio_s3_cache\")\n794:    def _validate_s3_cache_dir(self, index_path: str) -> None:\n807:        paths = self.index[\"path\"].astype(str)\n808:        if not paths.str.startswith(\"s3://\").any():\n811:        example = paths[paths.str.startswith(\"s3://\")].iloc[0]\n813:            f\"The index {index_path} contains s3:// paths (e.g. {example}) but \"\n824:            \"    # or pass --s3-cache-dir <path> to the training script\\n\"\n840:    def _s3_cache_path(self, s3_uri: str) -> str:\n841:        \"\"\"Build a stable, human-readable local cache path for an S3 object.\"\"\"\n843:        base = os.path.basename(key) or \"object\"\n845:        _, ext = os.path.splitext(base_safe)\n851:        return os.path.join(self.s3_temp_dir, fname)\n853:    def _download_s3_object(self, s3_uri: str, local_path: str) -> None:\n854:        \"\"\"Download an S3 object to ``local_path``.\n859:        os.makedirs(os.path.dirname(local_path) or \".\", exist_ok=True)\n883:            client.download_file(bucket, key, local_path, Config=transfer_cfg)\n8