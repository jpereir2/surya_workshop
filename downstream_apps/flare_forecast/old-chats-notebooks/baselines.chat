ast/datasets/__pycache__/__init__.cpython-312.pyc\n/home/jovyan/tmp/surya_workshop/downstream_apps/flare_forecast/datasets/__pycache__/flare_dataset.cpython-312.pyc\n/home/jovyan/tmp/surya_workshop/downstream_apps/flare_forecast/datasets/__pycache__/template_dataset.cpython-312.pyc\n/home/jovyan/tmp/surya_workshop/downstream_apps/flare_forecast/datasets/flare_dataset.py\n/home/jovyan/tmp/surya_workshop/downstream_apps/flare_forecast/datasets/template_dataset.py\n/home/jovyan/tmp/surya_workshop/downstream_apps/flare_forecast/download_scalers.sh\n/home/jovyan/tmp/surya_workshop/downstream_apps/flare_forecast/download_scalers_and_weights.sh\n/home/jovyan/tmp/surya_workshop/downstream_apps/flare_forecast/git-save.chat\n/home/jovyan/tmp/surya_workshop/downstream_apps/flare_forecast/image_flip.chat\n/home/jovyan/tmp/surya_workshop/downstream_apps/flare_forecast/lightning_modules/__init__.py\n/home/jovyan/tmp/surya_workshop/downstream_apps/flare_forecast/lightning_modules/pl_simple_baseline.py\n/home/jovyan/tmp/surya_workshop/downstream_apps/flare_forecast/logs/data/20260914T175554Z_000_data_train_4689.log\n/home/jovyan/tmp/surya_workshop/downstream_apps/flare_forecast/logs/data/20260914T180911Z_000_data_train_92.log\n/home/jovyan/tmp/surya_workshop/downstream_apps/flare_forecast/logs/data/20260914T181458Z_000_data_train_158.log\n/home/jovyan/tmp/surya_workshop/downstream_apps/flare_forecast/logs/data/20260914T182021Z_000_data_train_144.log\n/home/jovyan/tmp/surya_workshop/downstream_apps/flare_forecast/logs/data/20260914T182354Z_000_data_train_186.log\n/home/jovyan/tmp/surya_workshop/downstream_apps/flare_forecast/logs/data/20260914T183101Z_000_data_train_186.log\n/home/jovyan/tmp/surya_workshop/downstream_apps/flare_forecast/logs/data/20260914T185030Z_000_data_train_963.log\n/home/jovyan/tmp/surya_workshop/downstream_apps/flare_forecast/logs/data/20260914T185444Z_000_data_train_357.log\n/home/jovyan/tmp/surya_workshop/downstream_apps/flare_forecast/logs/data/20260914T190