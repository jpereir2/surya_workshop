            "raw_output": "33:    \"from torch.utils.data import DataLoader\\n\",\n165:    \"train_dataset = flare_Dataset(\\n\",\n191:    \"# Notebooks 1 and 2 skip this block entirely: build_helio_dataloaders() in\\n\",\n203:    \"item = train_dataset.__getitem__(0)\\n\",\n246:    \"unnormalized_ts = train_dataset.inverse_transform_data(item['ts'][:,0,...])\\n\",\n426:      \"Cell \\u001b[0;32mIn[9], line 3\\u001b[0m\\n\\u001b[1;32m      1\\u001b[0m item \\u001b[38;5;241m=\\u001b[39m train_dataset\\u001b[38;5;241m.\\u001b[39m\\u001b[38;5;21m__getitem__\\u001b[39m(\\u001b[38;5;241m0\\u001b[39m)\\n\\u001b[1;32m      2\\u001b[0m \\u001b[38;5;28mprint\\u001b[39m(item[\\u001b[38;5;124m'\\u001b[39m\\u001b[38;5;124mforecast\\u001b[39m\\u001b[38;5;124m'\\u001b[39m])       \\u001b[38;5;66;03m# scalar label, e.g. array(0.42, dtype=float32)\\u001b[39;00m\\n\\u001b[0;32m----> 3\\u001b[0m \\u001b[38;5;28mprint\\u001b[39m(\\u001b[43mitem\\u001b[49m\\u001b[43m[\\u001b[49m\\u001b[38;5;124;43m'\\u001b[39;49m\\u001b[38;5;124;43mflipped\\u001b[39;49m\\u001b[38;5;124;43m'\\u001b[39;49m\\u001b[43m]\\u001b[49m\\u001b[38;5;241m.\\u001b[39mshape)  \\u001b[38;5;66;03m# image stack, e.g. (13, 2, 4096, 4096)\\u001b[39;00m\\n\",\n432:    \"item = train_dataset.__getitem__(0)\\n\",\n513:    \"    ts_frame = train_dataset.inverse_transform_data(item['ts'][:, t, ...])\\n\",\n547:    \"item = train_dataset.__getitem__(0)\\n\"\n679:    \"print(train_dataset.return_surya_stack)\"\n700:    \"print(train_dataset.return_surya_stack)\\n\",\n701:    \"print(train_dataset.load_forecast_frames)\\n\",\n804:    \"    ts_frame = train_dataset.inverse_transform_data(item['ts'][:, t, ...])\\n\",\n811:    \"    forecast_frame = train_dataset.inverse_transform_data(item['forecast'][:, l, ...])\\n\",\n927:    \"train_dataset = flare_Dataset(\\n\",\n954:    \"# Notebooks 1 and 2 skip this block entirely: build_helio_dataloaders() in\\n\",\n966:    \"## dataloader -- post flip check\\n\",\n977:    \"data_loader = DataLoader(\\n\",\n978:    \"                dataset=train_dataset,\\n\",\n1042:    \"    sample = train_dataset.__getitem__(0)\\n\",\n1067:    \"    s = train_dataset.__getitem__(0)\\n\",\n1076:    \"frame_a = train_dataset.inverse_transform_data(sample_a['ts'][:, 1, ...])[0]\\n\",\n1077:    \"frame_b = train_dataset.inverse_transform_data(sample_b['ts'][:, 1, ...])[0]\\n\",\n1100:    \"orig_p = train_dataset.flip_probability\\n\",\n1102:    \"train_dataset.flip_probability = 0.0\\n\",\n1103:    \"baseline = train_dataset.__getitem__(0)\\n\",\n1106:    \"train_dataset.flip_probability = 1.0\\n\",\n1107:    \"flipped = train_dataset.__getitem__(0)\\n\",\n1113:    \"train_dataset.flip_probability = orig_p\"",
