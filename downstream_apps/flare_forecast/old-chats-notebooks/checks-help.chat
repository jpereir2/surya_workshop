          {
            "raw_output": "270\t# ---------------------------------------------------------------------------\n271\t\n272\tclass RandomChannelMaskerTransform:\n273\t    \"\"\"Randomly zero-out AIA channels and optionally the HMI channel.\n274\t\n275\t    Used during pretraining to improve robustness to missing inputs.\n276\t\n277\t    Args:\n278\t        num_channels: Total number of channels in the input tensor.\n279\t        num_mask_aia_channels: Number of AIA channels to randomly zero-out per sample.\n280\t        phase: Dataset phase (e.g., ``\"train\"``). Included for future phase-specific logic.\n281\t        drop_hmi_probability: Probability of zeroing the last (HMI) channel.\n282\t    \"\"\"\n283\t\n284\t    def __init__(self, num_channels, num_mask_aia_channels, phase, drop_hmi_probability):\n285\t        self.num_channels = num_channels\n286\t        self.num_mask_aia_channels = num_mask_aia_channels\n287\t        self.drop_hmi_probability = drop_hmi_probability\n288\t\n289\t    def __call__(self, input_tensor):\n290\t        \"\"\"Apply random channel masking to a (C, T, H, W) image stack.\n291\t\n292\t        Zeros out ``num_mask_aia_channels`` randomly chosen channels uniformly across all\n293\t        timesteps, and independently drops the last channel (HMI) with probability\n294\t        ``drop_hmi_probability``.\n295\t\n296\t        Args:\n297\t            input_tensor: Array of shape (C, T, H, W).\n298\t\n299\t        Returns:\n300\t            Masked array of the same shape.\n301\t        \"\"\"\n302\t        C, T, H, W = input_tensor.shape\n303\t\n304\t        channels_to_mask = random.sample(range(C), self.num_mask_aia_channels)\n305\t        mask = torch.ones((C, 1, 1, 1))\n306\t        mask[channels_to_mask, ...] = 0\n307\t        masked_tensor = input_tensor * mask\n308\t\n309\t        if self.drop_hmi_probability > random.random():",
