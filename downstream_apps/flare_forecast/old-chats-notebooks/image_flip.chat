          {
            "tool_call_id": "toolu_bdrk_01YTgT6aTU2NiGN7mcVgAUa1",
            "raw_output": "605\t            axis=1,\n606\t        )\n607\t\n608\t    def _get_index_data(self, idx: int) -> dict:\n609\t        \"\"\"Build and return the sample dict for a single reference timestep.\n610\t\n611\t        Samples historical input frames randomly from ``time_delta_input_minutes``,\n612\t        applies channel masking and optional vertical flip, then assembles the sample\n613\t        dict described in ``__getitem__``.\n614\t        \"\"\"\n615\t        reference_timestep = self.valid_indices[idx]\n616\t\n617\t        # The last entry in time_delta_input_minutes is always the \"now\" frame (offset 0\n618\t        # relative to the reference timestep). The remaining n-1 input frames are sampled\n619\t        # randomly from the earlier offsets, giving the model varied historical context\n620\t        # across training steps.\n621\t        input_time_deltas = np.array(\n622\t            sorted(random.sample(self.time_delta_input_minutes[:-1], self.n_input_timestamps - 1))\n623\t            + [self.time_delta_input_minutes[-1]]\n624\t        )\n625\t        input_timesteps = reference_timestep + input_time_deltas\n626\t        stacked_inputs = self._load_and_stack_frames(input_timesteps)\n627\t\n628\t        if self.num_mask_aia_channels > 0 or self.drop_hmi_probability:\n629\t            stacked_inputs = self.masker(stacked_inputs)\n630\t\n631\t        # All time deltas are expressed relative to \"now\" (the last input frame), in hours.\n632\t        now_delta = input_time_deltas[-1]\n633\t        time_delta_input_float = (\n634\t            (now_delta - input_time_deltas) / np.timedelta64(1, \"h\")\n635\t        ).astype(np.float32)\n636\t\n637\t        sample = {\n638\t            \"ts\": stacked_inputs,\n639\t            \"time_delta_input\": time_delta_input_float,\n640\t        }\n641\t\n642\t        if self.load_forecast_frames:\n643\t            target_time_deltas = np.array(self.time_delta_target_minutes)\n644\t            target_timesteps = reference_timestep + target_time_deltas\n645\t            sample[\"forecast\"] = self._load_and_stack_frames(target_timesteps)\n646\t            sample[\"lead_time_delta\"] = (\n647\t                (now_delta - target_time_deltas) / np.timedelta64(1, \"h\")\n648\t            ).astype(np.float32)\n649\t\n650\t        if self.random_vert_flip and torch.bernoulli(torch.ones(()) / 2) == 1:\n651\t            sample[\"ts\"] = np.flip(sample[\"ts\"], axis=-2).copy()\n652\t            if self.load_forecast_frames:\n653\t                sample[\"forecast\"] = np.flip(sample[\"forecast\"], axis=-2).copy()\n654\t\n655\t        if self.use_latitude_in_learned_flow:\n656\t            from sunpy.coordinates.ephemeris import get_earth\n657\t\n658\t            sample[\"input_latitudes\"] = [get_earth(ts).lat.value for ts in input_timesteps]\n659\t            if self.load_forecast_frames:\n660\t                sample[\"forecast_latitude\"] = [get_earth(ts).lat.value for ts in target_timesteps]\n661\t\n662\t        return sample\n663\t\n664\t    # ------------------------------------------------------------------",
            "raw_input": {
