              "command": "cat /home/jovyan/tmp/surya_workshop/downstream_apps/flare_forecast/configs/config_script.yaml | grep -n -A2 -B2 \"time_delta_input_minutes\\|n_input_timestamps\\|ds_time_column\"\necho \"---flare_dataset.py---\"\ngrep -n \"time_delta_input_minutes\\|_get_index_data\\|__getitem__\\|def \" /home/jovyan/tmp/surya_workshop/downstream_apps/flare_forecast/datasets/flare_dataset.py"
            },
            "title": "cat config_script.yaml | grep -n -A2 -B2 \"time_delta_input_minutes\\|n_input_timestamps\\|ds_time_column\" echo \"---flare_dataset.py---\" grep -n \"time_delta_input_minutes\\|_get_index_data\\|__getitem__\\|def \" flare_dataset.py",
            "raw_output": "40-  channels: [aia94, aia131, aia171, aia193, aia211, aia304, aia335, aia1600,\n41-             hmi_m, hmi_bx, hmi_by, hmi_bz, hmi_v]\n42:  time_delta_input_minutes: [-60, -36]   # Offsets (minutes) of input frames relative to reference timestep\n43-  time_delta_target_minutes: 0   # Step size (minutes) between forecast frames\n44-\n45-  # -- Downstream label alignment (flare catalog \u2192 Surya index) --\n46-  flare_index_path: ../data/hek_flare_catalog.csv\n47:#  ds_time_column: start_time      # Column in the flare catalog used as the event timestamp\n48:  ds_time_column: peak_time      # Column in the flare catalog used as the event timestamp\n49-  ds_time_tolerance: 4d           # Max allowed gap between catalog and Surya timestamps\n50-  ds_match_direction: forward     # \"forward\": use solar state *before* the flare (causal)\n--\n131-    type: linear        # Options: linear | fourier | perceiver\n132-    n_queries: null     # Required for perceiver; unused otherwise\n133:    time_dim: 2         # Number of input timesteps (must match time_delta_input_minutes length)\n134-\n135-  # -- Fine-tuning head --\n---flare_dataset.py---\n38:    def __init__(\n124:    def __len__(self):\n127:    def __getitem__(self, idx: int) -> dict:\n137:            ``HelioNetCDFDataset.__getitem__`` (ts, time_delta_input, lead_time_delta, etc.).\n139:        sample = super().__getitem__(idx=idx) if self.return_surya_stack else {}",
