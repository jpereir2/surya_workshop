            "title": "cd flare_forecast && python -c \" import json, base64, io import numpy as np from PIL import Image nb=json.load(open('0_dataset_TEST-2.ipynb')) c=nb['cells'][21] imgs=[o for o in c['outputs'] if o.get('output_type')=='display_data'] for j,o in enumerate(imgs): d=o['data']['image/png'] raw=base64.b64decode(d if isinstance(d,str) else ''.join(d)) im=Image.open(io.BytesIO(raw)).convert('RGB') a=np.asarray(im) print(f'===== FIGURE {j} size={a.shape[1]}x{a.shape[0]} =====') # background = near-white nonbg = ~np.all(a>245, axis=2) colprof = nonbg.sum(axis=0) rowprof = nonbg.sum(axis=1) def runs(prof, thresh): out=[]; s=None for i,v in enumerate(prof): if v>thresh and s is None: s=i elif v<=thresh and s is not None: out.append((s,i-1,i-s)); s=None if s is not None: out.append((s,len(prof)-1,len(prof)-s)) return out print(' COLUMN bands (x_start, x_end, width), thresh=2% height:') for r in runs(colprof, 0.02*a.shape[0]): print(' ',r) print(' ROW bands (y_start, y_end, height), thresh=2% width:') for r in runs(rowprof, 0.02*a.shape[1]): print(' ',r) \"",
