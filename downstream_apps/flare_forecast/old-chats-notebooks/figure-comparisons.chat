            "raw_input": {
              "command": "cd /home/jovyan/tmp/surya_workshop/downstream_apps/flare_forecast && python -c \"\nimport json, base64, io\nimport numpy as np\nfrom PIL import Image\n\nnb=json.load(open('0_dataset_TEST-2.ipynb'))\nc=nb['cells'][21]\nimgs=[o for o in c['outputs'] if o.get('output_type')=='display_data']\nfor j,o in enumerate(imgs):\n    d=o['data']['image/png']\n    raw=base64.b64decode(d if isinstance(d,str) else ''.join(d))\n    im=Image.open(io.BytesIO(raw)).convert('RGB')\n    a=np.asarray(im)\n    print(f'===== FIGURE {j}  size={a.shape[1]}x{a.shape[0]} =====')\n    # background = near-white\n    nonbg = ~np.all(a>245, axis=2)\n    colprof = nonbg.sum(axis=0)\n    rowprof = nonbg.sum(axis=1)\n    def runs(prof, thresh):\n        out=[]; s=None\n        for i,v in enumerate(prof):\n            if v>thresh and s is None: s=i\n            elif v<=thresh and s is not None: out.append((s,i-1,i-s)); s=None\n        if s is not None: out.append((s,len(prof)-1,len(prof)-s))\n        return out\n    print(' COLUMN bands (x_start, x_end, width), thresh=2% height:')\n    for r in runs(colprof, 0.02*a.shape[0]): print('   ',r)\n    print(' ROW bands (y_start, y_end, height), thresh=2% width:')\n    for r in runs(rowprof, 0.02*a.shape[1]): print('   ',r)\n\"\n"
