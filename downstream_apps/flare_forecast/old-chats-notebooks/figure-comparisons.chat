            "raw_output": " 85: \n 86: def _show(ax, img, channel, label, factor):\n 87:     lim = _lim(img, factor)\n 88:     if \"hmi\" not in channel:\n 89:         ax.imshow(img, cmap=f\"sdo{channel}\", vmin=0, vmax=lim)\n 90:         fc = \"w\"\n 91:     else:\n 92:         fc = \"k\"\n 93:         ax.imshow(img, cmap=\"coolwarm\" if \"_v\" in channel else \"hmimag\",\n 94:                   vmin=-lim, vmax=lim)\n 95:     ax.text(0.01, 0.99, label, transform=ax.transAxes, ha=\"left\", va=\"top\",\n 96:             color=fc, fontsize=7)\n 97:     ax.set_xticks([]); ax.set_yticks([])\n 98: \n 99: n_cols  = n_inputs + 1 + n_lead                       # +1 = spacer column\n100: w_ratios = [1] * n_inputs + [0.18] + [1] * n_lead\n101: \n102: for tag, factor in SCALE_VERSIONS:\n103:     n_rows = len(CHANNELS_TO_PLOT) * 2                # image rows + diff rows\n104:     fig = plt.figure(figsize=(4 * (n_inputs + n_lead) + 1.2, 4.1 * n_rows), dpi=90)\n105:     gs = gridspec.GridSpec(n_rows, n_cols, figure=fig,\n106:                            width_ratios=w_ratios, wspace=0.04, hspace=0.10)\n107: \n108:     # ---- image rows: one per channel, columns = time ----\n109:     for r, c in enumerate(CHANNELS_TO_PLOT):\n110:         ins, tgts = frames[c]\n111:         for t in range(n_inputs):\n112:             _show(fig.add_subplot(gs[r, t]), ins[t], c,\n113:                   f\"{c}\\n{input_times[t]}\\nINPUT {t}\", factor)\n114:         for l in range(n_lead):\n115:             _show(fig.add_subplot(gs[r, n_inputs + 1 + l]), tgts[l], c,\n116:                   f\"{c}\\n{target_times[l]}\\nGROUND TRUTH\", factor)\n117: \n118:     # ---- diff rows: centered below, layout of grid above untouched ----\n119:     for r, c in enumerate(CHANNELS_TO_PLOT):\n120:         ins, tgts = frames[c]\n121:         diffs = []\n122:         if n_inputs >= 2:\n123:             diffs.append((ins[-1] - ins[-2],\n124:                           f\"{c}  \u0394 inputs\\n{input_times[-1]} \u2212 {input_times[-2]}\"))\n125:         diffs.append((tgts[0] - ins[-1],\n126:                       f\"{c}  \u0394 to ground truth\\n{target_times[0]} \u2212 {input_times[-1]}\"))\n127: \n128:         inner = gs[len(CHANNELS_TO_PLOT) + r, :].subgridspec(\n129:             1, 4, width_ratios=[0.5, 1, 1, 0.5], wspace=0.18)\n130:         for k, (d, title) in enumerate(diffs):\n131:             ax = fig.add_subplot(inner[0, k + 1])\n132:             lim = np.percentile(np.abs(d), 99) * factor or 1.0\n133:             im = ax.imshow(d, cmap=\"coolwarm\", vmin=-lim, vmax=lim)\n134:             ax.set_title(title, fontsize=7)\n135:             ax.set_xticks([]); ax.set_yticks([])\n136:             fig.colorbar(im, ax=ax, fraction=0.046, pad=0.03)\n137: \n138:     fig.suptitle(\n139:         f\"[{tag} scaling, 99th pct \u00d7 {factor}]   {row['GOES_class']}   \"\n140:         f\"anchor='{anchor_col}' @ {anchor_event}   |   GT frame {gt_time} \"\n141:         f\"(gap {gap.total_seconds()/60:.0f} min)   |   label={float(item['ground_truth']):.4g}\",\n142:         fontsize=10, y=0.995)\n143:     plt.show()\nShell cwd was reset to /home/jovyan/tmp/surya_workshop/downstream_apps/flare_forecast/data"
