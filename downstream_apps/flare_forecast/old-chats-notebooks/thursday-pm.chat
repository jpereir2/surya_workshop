            "title": "cd flare_forecast echo \"=== checkpoints in app dir ===\" ls -la *.ckpt 2>/dev/null || echo \"(none)\" echo echo \"=== last.ckpt written by ModelCheckpoint(save_last=True) ===\" find jpereira/wandb/wandb_tmp -name 'last.ckpt' -newermt '2026-09-17 19:00' -printf '%TH:%TM %s bytes %p\\n' 2>/dev/null find jpereira/wandb/wandb_tmp -name '*.ckpt' -newermt '2026-09-17 19:30' -printf '%TH:%TM %s bytes %p\\n' 2>/dev/null echo echo \"=== result CSVs ===\" for f in results_baseline.csv results_finetuned.csv results_all.csv; do [ -e \"$f\" ] && printf '%-26s %s rows=%s\\n' \"$f\" \"$(date -r $f +%H:%M)\" \"$(awk 'NR>1' $f | wc -l)\" || echo \"$f -- MISSING\" done",
