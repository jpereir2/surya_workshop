            "raw_output": "=== cache state ===\n3.6T\t/home/jovyan/scratch_space/surya_cache\n6710\n\n=== how helio.py resolves + caches a path ===\n50:# Optional S3 support via boto3 (recommended: faster whole-object downloads).\n54:    import boto3\n55:    from boto3.s3.transfer import TransferConfig\n57:    boto3 = None\n71:def _resolve_s3_mode(s3_mode, s3_download_to_temp, s3_use_simplecache) -> str:\n74:    ``s3_download_to_temp`` and ``s3_use_simplecache`` are the legacy API. They were\n76:    dispatch, so setting ``s3_use_simplecache=True`` silently did nothing. They are\n79:    legacy_used = s3_download_to_temp is not None or s3_use_simplecache is not None\n81:    if legacy_used and s3_mode is not None:\n83:            \"Pass either s3_mode or the deprecated s3_download_to_temp/s3_use_simplecache \"\n84:            f\"flags, not both (got s3_mode={s3_mode!r}, s3_download_to_temp=\"\n85:            f\"{s3_download_to_temp!r}, s3_use_simplecache={s3_use_simplecache!r}).\"\n90:        # and won over simplecache.\n94:        elif s3_use_simplecache:\n95:            resolved = \"simplecache\"\n99:            \"s3_download_to_temp/s3_use_simplecache are deprecated; use \"\n100:            f\"s3_mode={resolved!r} instead. Valid modes: {', '.join(VALID_S3_MODES)}.\",\n106:    if s3_mode is None:\n109:    if s3_mode not in VALID_S3_MODES:\n111:            f\"Unknown s3_mode {s3_mode!r}. Valid modes are: {', '.join(VALID_S3_MODES)}.\\n\"\n112:            \"  download    \u2014 whole-object download to s3_cache_dir, then open locally (recommended)\\n\"\n113:            \"  simplecache \u2014 fsspec read-through cache into s3_cache_dir\\n\"\n116:    return s3_mode\n183:def fast_inverse_transform(data, means, stds, sl_scale_factors, epsilons):\n213:def transform(\n246:def inverse_transform_single_channel(data, mean, std, sl_scale_factor, epsilon):\n284:    def __init__(self, num_channels, num_mask_aia_channels, phase, drop_hmi_probability):\n289:    def __call__(self, input_tensor):\n363:        s3_mode: How S3 objects are read. One of:\n365:            - ``\"download\"`` (default) \u2014 fetch the whole object into ``s3_cache_dir`` with boto3\n368:            - ``\"simplecache\"`` \u2014 fsspec read-through cache into ``s3_cache_dir``.\n369:            - ``\"stream\"`` \u2014 direct s3fs handle; nothing is written to disk and ``s3_cache_dir``\n374:        s3_cache_dir: **Required unless ``s3_mode=\"stream\"``.** Local directory where S3 files are\n381:        s3_download_to_temp: **Deprecated** \u2014 use ``s3_mode`` instead. Kept for backward\n383:        s3_use_simplecache: **Deprecated** \u2014 use ``s3_mode`` instead. Kept for backward\n385:        s3_temp_dir: Internal override for the download directory. Defaults to ``s3_cache_dir``,\n387:        s3_boto3_max_concurrency: Number of parallel threads for boto3 multipart downloads.\n388:        s3_boto3_part_size_mb: Part size in MB for boto3 multipart downloads.\n396:    def __init__(\n414:        s3_mode: str | None = None,\n415:        s3_cache_dir: str | None = None,\n418:        # Deprecated aliases for s3_mode \u2014 see _resolve_s3_mode().\n419:        s3_use_simplecache: bool | None = None,\n421:        s3_boto3_max_concurrency: int = 4,\n422:        s3_boto3_part_size_mb: int = 64,\n437:        self.s3_mode = _resolve_s3_mode(s3_mode, s3_download_to_temp, s3_use_simplecache)\n438:        self.s3_cache_dir = s3_cache_dir\n440:        self.s3_temp_dir = s3_temp_dir if s3_temp_dir is not None else s3_cache_dir\n441:        # s3_cache_dir may legitimately be None for local-only indices (and for\n442:        # s3_mode=\"stream\"). _validate_s3_cache_dir() checks it against the actual\n445:        self.s3_boto3_max_concurrency = s3_boto3_max_concurrency\n446:        self.s3_boto3_part_size_mb = s3_boto3_part_size_mb\n488:        self.index = pd.read_csv(index_path)\n489:        self.index = self.index[self.index[\"present\"] == 1]\n490:        self.index[\"timestep\"] = pd.t