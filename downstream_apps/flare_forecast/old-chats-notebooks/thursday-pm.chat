            "title": "cd flare_forecast && python - <<'EOF' import json, re nb = json.load(open(\"2c_flip_minimal.ipynb\")) for i, c in enumerate(nb[\"cells\"]): src = \"\".join(c[\"source\"]) if \"def evaluate\" in src: print(\"--- evaluate() signature, cell\", i) for line in src.splitlines(): if \"def evaluate\" in line or \"flip_probability\" in line or \"paired\" in line: print(\" \", line.rstrip()) # dataset variable names names = set() for c in nb[\"cells\"]: for m in re.finditer(r\"^\\s*(\\w*_?ds|\\w*dataset)\\s*=\", \"\".join(c[\"source\"]), re.M): names.add(m.group(1)) print(\"\\n--- dataset-ish variables assigned:\", sorted(names)) EOF",
