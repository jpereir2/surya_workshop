      "id": "bd48f504-66e8-49ae-9c06-c5b14208d3d1",
      "metadata": {
        "tool_calls": [
          {
            "locations": [
              "/home/jovyan/tmp/surya_workshop/workshop_infrastructure/datasets/helio.py"
