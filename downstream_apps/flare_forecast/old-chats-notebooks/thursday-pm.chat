            "tool_call_id": "toolu_bdrk_01QHDzJMyP2rimUtC8sXXzDs",
            "raw_output": "730\t        else:  # \"stream\"\n731\t            opener = self._get_s3fs().open(s3_uri, mode=\"rb\")\n732\t\n733\t        with opener as f:\n734\t            with xr.open_dataset(f, engine=\"h5netcdf\", chunks=None, cache=False) as ds:\n735\t                return ds[channels].to_array().load().to_numpy()\n736\t\n737\t    def _read_s3_via_download(self, s3_uri: str, channels: list[str]) -> np.ndarray:\n738\t        \"\"\"Download the whole object to the local cache, then open it with xarray.\n739\t\n740\t        The download is written to a process-unique ``.partial`` file and then renamed\n741\t        into place. The uniqueness matters: with ``num_workers>0`` and/or several DDP\n742\t        ranks sharing one ``s3_cache_dir``, two processes can pick the same timestep at\n743\t        the same time. A shared temp name would let one process clobber or delete the\n744\t        file another is still writing, and the rename would then publish a truncated\n745\t        object into the cache permanently.\n746\t        \"\"\"\n747\t        self._require_s3_cache_dir()\n748\t\n749\t        cache_path = self._s3_cache_path(s3_uri)\n750\t        os.makedirs(os.path.dirname(cache_path) or \".\", exist_ok=True)\n751\t\n752\t        if not os.path.exists(cache_path):\n753\t            tmp_path = f\"{cache_path}.{os.getpid()}.{uuid4().hex}.partial\"\n754\t            try:\n755\t                self._download_s3_object(s3_uri, tmp_path)\n756\t                # os.replace is atomic on POSIX: a concurrent writer either wins or\n757\t                # loses the race, but the published file is always complete.\n758\t                os.replace(tmp_path, cache_path)\n759\t            except BaseException:\n760\t                if os.path.exists(tmp_path):\n761\t                    os.remove(tmp_path)\n762\t                raise\n763\t\n764\t        with xr.open_dataset(cache_path, engine=\"h5netcdf\", chunks=None, cache=False) as ds:\n765\t            return ds[channels].to_array().load().to_numpy()\n766\t\n767\t    # ------------------------------------------------------------------\n768\t    # S3 helpers\n769\t    # ------------------------------------------------------------------\n770\t\n771\t    def _is_s3_path(self, path: str) -> bool:\n772\t        \"\"\"Return True if ``path`` is an S3 URI (starts with ``s3://``).\"\"\"\n773\t        return isinstance(path, str) and path.startswith(\"s3://\")\n774\t\n775\t    @staticmethod\n776\t    def _suggested_cache_dir() -> str:\n777\t        \"\"\"Return a plausible cache directory for this machine, for use in error messages.\"\"\"\n778\t        for env_var in (\"SCRATCH\", \"TMPDIR\"):\n779\t            root = os.environ.get(env_var)\n780\t            if root:\n781\t                return os.path.join(root, \"helio_s3_cache\")\n782\t        return os.path.join(os.path.expanduser(\"~\"), \".cache\", \"surya_workshop\", \"helio_s3_cache\")\n783\t\n784\t    def _require_s3_cache_dir(self) -> None:\n785\t        \"\"\"Raise if a cache directory is needed but not configured.\"\"\"\n786\t        if self.s3_cache_dir is None:\n787\t            raise ValueError(\n788\t                f\"s3_cache_dir must be set when s3_mode={self.s3_mode!r}.\\n\"\n789\t                f\"Suggested value for this machine: {self._suggested_cache_dir()}\\n\"\n790\t                \"Each full-resolution SDO NetCDF file is ~1 GB, so budget roughly \"\n791\t                \"1 GB x (number of unique timesteps) of free space.\"\n792\t            )\n793\t\n794\t    def _validate_s3_cache_dir(self, index_path: str) -> None:\n795\t        \"\"\"Fail at construction time if the index needs a cache dir that is not configured.\n796\t\n797\t        The index is already in memory in the main process, so this check is cheap and\n798\t        exact. Without it the same error only fires on the first ``__getitem__`` inside a\n799\t        spawned DataLoader worker \u2014 after asset downloads, model construction and Lightning\n800\t        setup \u2014 surfacing as a worker-exit traceback minutes into a run.\n801\t\n802\t        ``s3_mode=\"stream\"`` writes nothing to disk and is therefore exempt.\n803\t        \"\"\"\n804\t        if self.s3_cache_dir is not None or self.s3_mode == \"stream\":\n805\t            return\n806\t\n807\t        paths = self.index[\"path\"].astype(str)\n808\t        if not paths.str.startswith(\"s3://\").any():\n809\t            return  # local-only index: no cache dir needed\n810\t\n811\t        example = paths[paths.str.startswith(\"s3://\")].iloc[0]\n812\t        raise ValueError(\n813\t            f\"The index {index_path} contains s3:// paths (e.g. {example}) but \"\n814\t            f\"s3_cache_dir is not set (s3_mode={self.s3_mode!r}).\\n\"\n815\t            \"\\n\"\n816\t            \"Set it in the data: section of your config YAML:\\n\"\n817\t            \"\\n\"\n818\t            \"    data:\\n\"\n819\t            f\"      s3_cache_dir: {self._suggested_cache_dir()}\\n\"\n820\t            \"\\n\"\n821\t            \"...or, to keep the config machine-independent, set it outside the config:\\n\"\n822\t            \"\\n\"\n823\t            f\"    export SURYA_WS_CACHE_DIR={self._suggested_cache_dir()}\\n\"\n824\t            \"    # or pass --s3-cache-dir <path> to the training script\\n\"\n825\t            \"\\n\"\n826\t            \"Each full-resolution SDO NetCDF file is ~1 GB, so pick a filesystem with \"\n827\t            \"roughly 1 GB x (number of unique timesteps) free.\\n\"\n828\t            \"Alternatively set s3_mode: stream to read without a local cache \"\n829\t            \"(not recommended for NetCDF/HDF5 \u2014 it requires random seeks).\"\n830\t        )\n831\t\n832\t    def _get_s3fs(self):\n833\t        \"\"\"Lazily create and cache an ``s3fs.S3FileSystem`` instance (per process).\"\"\"\n834\t        if s3fs is None:\n835\t            raise ImportError(\"s3fs is required. Install via: pip install s3fs fsspec\")\n836\t        if self._s3fs is None:\n837\t            self._s3fs = s3fs.S3FileSystem(**self.s3fs_kwargs, **self.s3_storage_options)\n838\t        return self._s3fs\n839\t\n840\t    def _s3_cache_path(self, s3_uri: str) -> str:\n841\t        \"\"\"Build a stable, human-readable local cache path for an S3 object.\"\"\"\n842\t        bucket, key = parse_s3_uri(s3_uri)\n843\t        base = os.path.basename(key) or \"object\"\n844\t        base_safe = re.sub(r\"[^A-Za-z0-9._-]+\", \"_\", base).strip(\"._-\") or \"object\"\n845\t        _, ext = os.path.splitext(base_safe)\n846\t        suffix = ext if ext else \".nc\"\n847\t        key_hash = hashlib.sha1(f\"{bucket}/{key}\".encode()).hexdigest()\n848\t        fname = f\"{bucket}__{key_hash}__{base_safe}\"\n849\t        if not fname.endswith(suffix):\n850\t            fname += suffix\n851\t        return os.path.join(self.s3_temp_dir, fname)\n852\t\n853\t    def _download_s3_object(self, s3_uri: str, local_path: str) -> None:\n854\t        \"\"\"Download an S3 object to ``local_path``.\n855\t\n856\t        Uses boto3's transfer manager when available (parallel multipart downloads),\n857\t        otherwise falls back to streaming via s3fs.\n858\t        \"\"\"\n859\t        os.makedirs(os.path.dirname(local_path) or \".\", exist_ok=True)\n860\t\n861\t        if boto3 is not None:\n862\t            anon = bool(self.s3_storage_options.get(\"anon\") or self.s3fs_kwargs.get(\"anon\"))\n863\t            region = (os.environ.get(\"AWS_REGION\")\n864\t                      or os.environ.get(\"AWS_DEFAULT_REGION\")\n865\t                      or detect_ec2_region())\n866\t            client = make_s3_client(\n867\t                anon=anon,\n868\t                region=region,\n869\t                # Pool must exceed the thread count or multipart threads contend.\n870\t                pool_size=max(32, self.s3_boto3_max_concurrency * 2),\n871\t                # Retry hard: a failed read kills the training run.\n872\t                max_attempts=10,\n873\t            )\n874\t\n875\t            transfer_cfg = TransferConfig(\n876\t                multipart_threshold=self.s3_boto3_part_size_mb * 1024 * 1024,\n877\t                multipart_chunksize=self.s3_boto3_part_size_mb * 1024 * 1024,\n878\t                max_concurrency=self.s3_boto3_max_concurrency,\n879\t                use_threads=True,",
            "status": "completed"
          }
        ]
      },
